+@triton.jit
+def _ple_int8_dequant_kernel(
+    src_ptr,
+    out_ptr,
+    ROW_BYTES: tl.constexpr,
+    DIM: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    """One staged INT8 row (DIM int8, then an fp16 scale) -> DIM output values."""
+    row = tl.program_id(0).to(tl.int64)
+    base = src_ptr + row * ROW_BYTES
+    offs = tl.arange(0, BLOCK)
+    mask = offs < DIM
+    q = tl.load(base + offs, mask=mask, other=0)
+    lo = tl.load(base + DIM).to(tl.uint16)
+    hi = tl.load(base + DIM + 1).to(tl.uint16)
+    scale = ((hi << 8) | lo).to(tl.float16, bitcast=True).to(tl.float32)
+    values = q.to(tl.int8, bitcast=True).to(tl.float32) * scale
+    tl.store(out_ptr + row * DIM + offs, values.to(out_ptr.dtype.element_ty), mask=mask)
+
+# numpy has no bfloat16, so rows are gathered through a same-width int view.
+_PLE_STORAGE_NUMPY_DTYPES = {1: np.int8, 2: np.int16, 4: np.int32}
+_PLE_STORAGE_TORCH_DTYPES = {1: torch.int8, 2: torch.int16, 4: torch.int32}
+
+# Look-ahead page prefetch for the mmap PLE table.
+#
+# Qwen4ExpPLEMmapHostEmbedding._lookup gathers rows with np.take over the
+# mmap. Each page not in the page cache is a synchronous 4 KiB read at queue
+# depth 1, ~232 us on a DRAM-less QLC drive. A 512-token chunk touches ~8.7k
+# pages and takes ~1.9 s cold. Prefill runs at ~270 tok/s cold and 4-5k tok/s
+# warm. A cold 42k-token prompt took ~100 s to the first token (README, "Time
+# to first token").
+#
+# The drive reads ~40k random pages/s with a deep queue. The n-gram rows
+# depend only on the prompt, so they are known at admission. A background
+# thread computes them and passes their pages to process_madvise(MADV_WILLNEED)
+# in position order, ahead of the gather. Advising a cached page costs ~1 us.
+#
+# process_madvise takes up to 1024 ranges per call. Podman's default seccomp
+# profile allows it only with CAP_SYS_PTRACE, which the compose files add.
+# Without it the thread calls madvise once per range, with the same NVMe
+# throughput and ~20x the CPU time.
+#
+# VLLM_PLE_PREFETCH=0 disables the prefetch.
+
+_PLE_PREFETCH_ENV = "VLLM_PLE_PREFETCH"
+# Gathers up to this many rows (decode batches) advise their pages first.
+_PLE_GATHER_ADVISE_MAX_ROWS = 256
+# local-03: VLLM_PLE_GATHER_ADVISE=0 skips only the decode-path advise_now
+# (decode-06), keeping the prompt prefetch thread. advise_now is one
+# process_madvise per decode step (~1.9 ms/token on the critical PP0 rank of
+# the ESXi VM); with enough page cache the PLE rows are mostly resident anyway.
+_PLE_GATHER_ADVISE = os.environ.get("VLLM_PLE_GATHER_ADVISE", "1").strip() not in ("", "0")
+# local-34: cheaper advise_now on the decode path (PP rank 0's critical path,
+# between the D2H wait for the ids and np.take).
+#   VLLM_PLE_ADVISE_DEDUPE=1: one iovec for each row's first page, plus one for
+#     its last page only when the row crosses a page boundary (~6% of the
+#     320-byte rows), instead of always two. Same page set, ~half the iovecs.
+#   VLLM_PLE_ADVISE_THREADS=N (> 1): split the iovecs over the calling thread
+#     plus N-1 persistent helper threads (the ctypes syscall releases the GIL),
+#     only when every part gets at least VLLM_PLE_ADVISE_SPLIT_MIN iovecs.
+#     Pays off on cold rows, where each WILLNEED page starts a read.
+# Both unset/0/1: the l30 code path, byte for byte the same syscall.
+_PLE_ADVISE_DEDUPE = os.environ.get("VLLM_PLE_ADVISE_DEDUPE", "0").strip() not in ("", "0")
+
