+                triton.knobs.runtime.launch_enter_hook,
+                triton.knobs.runtime.launch_exit_hook,
+                *args,
+            )
+            return out
+        except Exception:
+            _DET_KERNELS.pop(key, None)
+    bs_p2 = triton.next_power_of_2(block_size)
+    ck = _det_expert_order_kernel[(grid0,)](
+        sorted_token_ids,
+        out,
+        expert_ids,
+        num_tokens_post_padded,
+        n,
+        n_blocks,
+        BS=block_size,
+        BS_P2=bs_p2,
+        W=32,
+        CH=64,
+        num_warps=2,
+    )
+    if _DET_FAST_LAUNCH and ck is not None and hasattr(ck, "run"):
+        ck.det_bs_p2 = bs_p2
+        _DET_KERNELS[key] = ck
+    return out
