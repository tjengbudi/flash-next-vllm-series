+@triton.jit
+def _hc_up_gate_mix_kernel(
+    lora_ptr, wq_ptr, ws_ptr, xn_ptr, out_ptr,
+    stride_lora, stride_xn, stride_out,
+    M: tl.constexpr, K: tl.constexpr, HC_DIM: tl.constexpr, HC: tl.constexpr,
+    GS: tl.constexpr, BLOCK_H: tl.constexpr, BLOCK_K: tl.constexpr,
