+    valid_count = tl.load(indices_ptr + row * stride_indices_row + TOPK)
+    in_range = columns < tl.minimum(valid_count, TOPK)
+    token = tl.load(
+        indices_ptr + row * stride_indices_row + columns, mask=in_range, other=-1
+    )
+    valid = in_range & (token >= 0)
+    token_bucket = (tl.maximum(token, 0) // PAGE_SIZE) // pages_per_bucket
+    offset = 0
+    for b in range(0, num_buckets):
+        tl.store(part_start_ptr + local_row * stride_part_start_row + b, offset)
+        selected = valid & (token_bucket == b)
+        position = offset + tl.cumsum(selected.to(tl.int32), 0) - 1
+        tl.store(part_ptr + local_row * stride_part_row + position, token, mask=selected)
+        offset += tl.sum(selected.to(tl.int32), 0)
+    tl.store(part_start_ptr + local_row * stride_part_start_row + num_buckets, offset)
+
+
+def qsa_staged_arena_pages(arena_bytes: int, page_bytes: int) -> int:
+    """Number of logical pages the staging arena holds (at least one)."""
+    return max(1, arena_bytes // max(page_bytes, 1))
+
+
+def qsa_sparse_paged_attention_staged(
+    q: torch.Tensor,
+    kv_cache: torch.Tensor,
+    logical_indices: torch.Tensor,
+    block_table_row: torch.Tensor,
+    rows: torch.Tensor,
+    max_logical_page: int,
+    arena: torch.Tensor,
+    use_prefill_config: bool,
+    out: torch.Tensor,
+    *,
+    output_gate: torch.Tensor,
+    k_scale: float | None = None,
+    v_scale: float | None = None,
+    host_kv: torch.Tensor | None = None,
+    physical_pages: list[int] | None = None,
+    prefetched_pages: int = 0,
+) -> None:
+    """Run the rows in ``rows`` against host-resident K/V via the arena.
+
+    local-50: with ``host_kv`` (the pinned CPU pool behind ``kv_cache``) and
+    ``physical_pages`` (the request's block ids on the host) each bucket is
+    filled with cudaMemcpyAsync, i.e. by the copy engine, instead of an
+    index_select kernel reading host memory through UVA. The first
+    ``prefetched_pages`` pages of bucket 0 are already in the arena
+    (qsa_prefetch_arena).
+
+    Caller contract (use the direct path when it cannot be met):
+      * ``rows`` belongs to a single request and ``block_table_row`` is that
+        request's block table row.
+      * ``kv_cache`` is the host (UVA) tensor shaped
+        ``[blocks, num_kv_heads, page_size, 2 * head_dim]`` and ``arena`` is a
+        GPU tensor of the same dtype whose first dimension is a page count.
+    """
+    num_rows = rows.numel()
+    if num_rows == 0:
+        return
+    assert output_gate.is_contiguous()
+    output_gate_view = output_gate.view_as(q)
+    pages_in_arena = arena.shape[0]
+    page_size = kv_cache.shape[2]
+    head_dim = kv_cache.shape[3] // 2
+    num_kv_heads = kv_cache.shape[1]
+    num_pages = max_logical_page + 1
+    num_buckets = triton.cdiv(num_pages, pages_in_arena)
+    assert arena.dtype == kv_cache.dtype
+    kv_cache, is_fp8 = _qsa_fp8_bytes(kv_cache)
+    arena, _ = _qsa_fp8_bytes(arena)
+    softmax_scale, output_scale = _qsa_scales(head_dim, is_fp8, k_scale, v_scale)
+    lut = _qsa_fp8_e4m3_lut(q.device) if is_fp8 else q
+
+    group_size = q.shape[1] // num_kv_heads
+    block_m = triton.next_power_of_2(group_size)
+    selection_width = logical_indices.shape[1] - 1
+    block_n, partial_warps, num_tiles, _ = _select_config(
+        num_rows, num_kv_heads, use_prefill_config, selection_width, is_fp8
+    )
+    num_stages = 2
+    tuned = _staged_sm86_config()
+    if tuned is not None:
+        block_n, partial_warps, num_stages = tuned
+        num_tiles = triton.cdiv(selection_width, block_n)
+
+    import os
+
+    partitioned = num_buckets > 1 and os.environ.get(
+        "VLLM_QSA_BUCKET_PART", "0"
+    ).strip() == "1"
+    if partitioned:
+        part = torch.empty(
+            (num_rows, selection_width), dtype=torch.int32, device=q.device
+        )
+        part_start = torch.empty(
+            (num_rows, num_buckets + 1), dtype=torch.int32, device=q.device
+        )
+        _qsa_bucket_partition_kernel[(num_rows,)](
+            logical_indices,
+            rows,
+            part,
+            part_start,
+            logical_indices.stride(0),
+            part.stride(0),
+            part_start.stride(0),
+            pages_in_arena,
+            num_buckets,
+            TOPK=selection_width,
+            PAGE_SIZE=page_size,
+            BLOCK=triton.next_power_of_2(selection_width),
+            num_warps=8,
+        )
+    else:
+        part = part_start = rows
+    if num_buckets == 1:
+        acc = max_state = norm_state = q
+    else:
+        acc = torch.empty(
+            (num_rows, q.shape[1], q.shape[2]), dtype=torch.float32, device=q.device
+        )
+        max_state = torch.empty(
+            (num_rows, q.shape[1]), dtype=torch.float32, device=q.device
+        )
+        norm_state = torch.empty_like(max_state)
+
+    for bucket in range(num_buckets):
+        page_lo = bucket * pages_in_arena
+        page_hi = min(page_lo + pages_in_arena, num_pages)
+        staged = arena[: page_hi - page_lo]
+        if host_kv is not None and physical_pages is not None:
+            first = prefetched_pages if bucket == 0 else 0
+            qsa_copy_pages(
+                arena, first, host_kv, physical_pages[page_lo + first : page_hi]
+            )
+        else:
+            physical = block_table_row[page_lo:page_hi].to(torch.int64)
+            torch.index_select(kv_cache, 0, physical, out=staged)
+        k_arena, v_arena = staged.transpose(1, 2).split(head_dim, dim=-1)
+        _qsa_sparse_staged_gqa_kernel[(num_rows, num_kv_heads)](
+            q,
+            k_arena,
+            v_arena,
+            logical_indices,
+            rows,
+            acc,
+            max_state,
+            norm_state,
+            out,
+            output_gate_view,
+            softmax_scale,
+            output_scale,
+            lut,
+            q.stride(0),
+            q.stride(1),
+            k_arena.stride(0),
+            k_arena.stride(1),
+            k_arena.stride(2),
+            v_arena.stride(0),
+            v_arena.stride(1),
+            v_arena.stride(2),
+            logical_indices.stride(0),
+            out.stride(0),
+            out.stride(1),
+            output_gate_view.stride(0),
+            output_gate_view.stride(1),
+            num_rows,
+            page_lo,
+            page_hi - page_lo,
+            part,
+            part_start,
+            part.stride(0) if partitioned else 0,
+            part_start.stride(0) if partitioned else 0,
+            bucket,
+            TOPK=selection_width,
+            PAGE_SIZE=page_size,
+            GROUP_SIZE=group_size,
+            HEAD_DIM=q.shape[2],
+            NUM_QUERY_HEADS=q.shape[1],
+            NUM_TILES=num_tiles,
+            BLOCK_M=block_m,
+            BLOCK_N=block_n,
+            FIRST_BUCKET=bucket == 0,
+            LAST_BUCKET=bucket == num_buckets - 1,
+            IS_FP8=is_fp8,
+            PARTITIONED=partitioned,
+            num_warps=partial_warps,
+            num_stages=num_stages,
+        )
+
+
+def qsa_copy_pages(
+    arena: torch.Tensor,
+    first_slot: int,
+    host_kv: torch.Tensor,
+    physical_pages: list[int],
+) -> None:
+    """Copy host pages into consecutive arena slots from ``first_slot`` on.
+
+    Runs of consecutive block ids become one cudaMemcpyAsync each, on the
+    current stream. ``host_kv`` is pinned (cudaHostRegister), so the copies go
+    through the copy engine and leave the SMs to the kernels around them.
+    """
+    slot = first_slot
+    index = 0
+    count = len(physical_pages)
+    while index < count:
+        start = physical_pages[index]
+        run = 1
+        while index + run < count and physical_pages[index + run] == start + run:
+            run += 1
+        arena[slot : slot + run].copy_(host_kv[start : start + run], non_blocking=True)
+        slot += run
+        index += run
+
+
+# local-50: copies of the next QSA layer's leading pages, made on a side
+# stream while the layers between the two QSA layers compute. One per device.
+_QSA_COPY_STREAMS: dict[torch.device, torch.cuda.Stream] = {}
+_QSA_PREFETCH: dict[torch.device, dict] = {}
+
+
+def qsa_prefetch_arena(
+    arena: torch.Tensor,
+    layer_name: str,
+    host_kv: torch.Tensor,
+    physical_pages: list[int],
+) -> None:
+    """Start copying ``physical_pages`` of ``layer_name`` into arena slot 0..n.
+
+    The copy waits for everything queued on the current stream so far, which
+    includes the last kernel that reads the arena. qsa_prefetch_take() must run
+    before anything else touches the arena.
+    """
+    device = arena.device
+    qsa_prefetch_fence(device)
+    if not physical_pages:
+        return
+    stream = _QSA_COPY_STREAMS.get(device)
+    if stream is None:
+        stream = torch.cuda.Stream(device=device)
+        _QSA_COPY_STREAMS[device] = stream
+    ready = torch.cuda.Event()
+    ready.record(torch.cuda.current_stream(device))
+    with torch.cuda.stream(stream):
+        stream.wait_event(ready)
+        qsa_copy_pages(arena, 0, host_kv, physical_pages)
+        done = torch.cuda.Event()
+        done.record(stream)
+    _QSA_PREFETCH[device] = {
+        "arena": arena.data_ptr(),
+        "layer": layer_name,
+        "pages": tuple(physical_pages),
+        "done": done,
+    }
+
+
+def qsa_prefetch_fence(device: torch.device) -> None:
+    """Order a pending prefetch before later work on the current stream."""
+    pending = _QSA_PREFETCH.pop(device, None)
+    if pending is not None:
+        torch.cuda.current_stream(device).wait_event(pending["done"])
+
+
+def qsa_prefetch_take(
+    arena: torch.Tensor, layer_name: str, physical_pages: list[int]
+) -> int:
+    """Fence a pending prefetch; return how many leading pages it already put
+    in the arena for this layer and request (0 if it was for something else).
+    """
+    device = arena.device
+    pending = _QSA_PREFETCH.get(device)
+    if pending is None:
+        return 0
+    qsa_prefetch_fence(device)
+    pages = pending["pages"]
+    if (
+        pending["arena"] != arena.data_ptr()
+        or pending["layer"] != layer_name
+        or tuple(physical_pages[: len(pages)]) != pages
+    ):
+        return 0
+    return len(pages)
+
+
+_QSA_ARENA_CACHE: dict[tuple, torch.Tensor | None] = {}
+
+
+def qsa_get_staging_arena(
+    kv_cache: torch.Tensor, arena_bytes: int
+) -> torch.Tensor | None:
+    """Return the staging arena shared by all layers on this rank.
+
+    Layers run one after another, so one arena is enough. Its size is rounded
+    down to whole KV blocks, with a minimum of one. If allocation fails, the
+    failure is cached and logged once, and prefill uses the direct path.
+    """
+    page_bytes = kv_cache[0].numel() * kv_cache.element_size()
+    pages = qsa_staged_arena_pages(arena_bytes, page_bytes)
+    key = (kv_cache.device, kv_cache.dtype, pages, tuple(kv_cache.shape[1:]))
+    if key in _QSA_ARENA_CACHE:
+        return _QSA_ARENA_CACHE[key]
+    from vllm.logger import init_logger
+
+    logger = init_logger(__name__)
+    try:
+        arena = torch.empty(
+            (pages, *kv_cache.shape[1:]),
+            dtype=kv_cache.dtype,
+            device=kv_cache.device,
+        )
+    except torch.OutOfMemoryError:
+        arena = None
+        logger.warning(
+            "QSA staging arena of %d blocks (%.0f MiB) does not fit on %s; "
+            "prefill reads host K/V row by row instead, which is several "
+            "times slower. Lower VLLM_QSA_KVO_ARENA or --kv-cache-memory-bytes.",
+            pages, pages * page_bytes / 2**20, kv_cache.device,
+        )
+    else:
+        logger.info(
+            "QSA staging arena: %d blocks x %d tokens, %.0f MiB on %s",
+            pages, kv_cache.shape[2], pages * page_bytes / 2**20, kv_cache.device,
+        )
+    _QSA_ARENA_CACHE[key] = arena
+    return arena
+
