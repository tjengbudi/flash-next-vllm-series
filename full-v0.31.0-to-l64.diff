diff -ruN '--exclude=*.orig' '--exclude=*.rej' a/vllm/v1/attention/backends/ple_recoverssm.py b/vllm/v1/attention/backends/ple_recoverssm.py
--- a/vllm/v1/attention/backends/ple_recoverssm.py
