+        )
+    n = sorted_token_ids.numel()
+    n_blocks = min(expert_ids.numel(), n // block_size)
+    if n_blocks == 0:
+        return sorted_token_ids
+    out = torch.empty_like(sorted_token_ids)
+    grid0 = (n + block_size - 1) // block_size
+    dev = sorted_token_ids.device
+    key = (
+        block_size,
+        sorted_token_ids.dtype,
+        expert_ids.dtype,
+        num_tokens_post_padded.dtype,
+        dev,
+    )
