+    NUM_SPLITS: tl.constexpr,
+    NUM_TILES: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    IS_FP8: tl.constexpr,
+) -> None:
+    """_qsa_sparse_paged_gqa_splitk_kernel with the row cache in front of K/V."""
+    row = tl.program_id(0)
+    kv_head = tl.program_id(1)
+    split_id = tl.program_id(2)
+    request = tl.load(token_to_req_ptr + row)
+    valid_count = tl.load(indices_ptr + row * stride_indices_row + TOPK)
+    epoch = tl.load(epoch_ptr)
+
+    head_offsets = tl.arange(0, BLOCK_M)
+    dim_offsets = tl.arange(0, HEAD_DIM)
+    column_offsets = tl.arange(0, BLOCK_N)
+    first_head = kv_head * GROUP_SIZE
+    query = tl.load(
+        q_ptr
+        + row * stride_q_row
+        + (first_head + head_offsets[:, None]) * stride_q_head
+        + dim_offsets[None, :],
+        mask=head_offsets[:, None] < GROUP_SIZE,
+        other=0.0,
+    )
+
+    max_value = tl.full((BLOCK_M,), -1.0e20, dtype=tl.float32)
+    normalizer = tl.zeros((BLOCK_M,), dtype=tl.float32)
+    accumulator = tl.zeros((BLOCK_M, HEAD_DIM), dtype=tl.float32)
+    score_scale = softmax_scale * 1.4426950408889634
+
+    tile_end = tl.minimum(NUM_TILES, tl.cdiv(tl.minimum(valid_count, TOPK), BLOCK_N))
+
+    for tile in range(split_id, tile_end, NUM_SPLITS):
+        columns = tile * BLOCK_N + column_offsets
+        valid, safe_page, page_offset = _qsa_row_cache_columns(
+            indices_ptr, block_table_ptr, row, request, columns,
+            stride_indices_row, stride_table_req, num_cache_blocks, num_requests,
+            TOPK, PAGE_SIZE, PAGE_TABLE_WIDTH,
+        )
+        cache_slot = safe_page * PAGE_SIZE + page_offset
+        region_slot = _qsa_row_cache_hash(cache_slot, NUM_SLOTS)
+        # A slot some column hit this step is not written this step, so its
+        # tag is stable. Any other slot's tag may be changing and is ignored.
+        hitmark = tl.load(hitmark_ptr + region_slot, mask=valid, other=0)
+        tag = tl.load(tag_ptr + region_slot, mask=valid, other=-1)
+        claim = tl.load(claim_ptr + region_slot, mask=valid, other=0)
+        stable = valid & (hitmark == epoch)
+        hit = stable & (tag == cache_slot)
+        miss = valid & ~hit
+        owner = miss & ~stable & (claim == ((epoch << 32) | cache_slot))
+        entry = region_slot.to(tl.int64) * NUM_KV_HEADS + kv_head
+        row_ptr = region_ptr + entry * (2 * HEAD_DIM)
+
+        # Host and region addresses share the UVA space, so one load serves
+        # both and the tile needs no more shared memory than the direct path.
+        keys = tl.load(
+            tl.where(
+                hit[None, :],
+                row_ptr[None, :] + dim_offsets[:, None],
+                k_cache_ptr
+                + safe_page[None, :] * stride_k_block
+                + page_offset[None, :] * stride_k_token
+                + kv_head * stride_k_head
+                + dim_offsets[:, None],
+            ),
+            mask=valid[None, :],
+            other=0.0,
+        )
+        values = tl.load(
+            tl.where(
+                hit[:, None],
+                row_ptr[:, None] + HEAD_DIM + dim_offsets[None, :],
+                v_cache_ptr
+                + safe_page[:, None] * stride_v_block
+                + page_offset[:, None] * stride_v_token
+                + kv_head * stride_v_head
+                + dim_offsets[None, :],
+            ),
+            mask=valid[:, None],
+            other=0.0,
+        )
+        tl.store(row_ptr[None, :] + dim_offsets[:, None], keys, mask=owner[None, :])
+        tl.store(
+            row_ptr[:, None] + HEAD_DIM + dim_offsets[None, :],
+            values,
+            mask=owner[:, None],
+        )
+        tl.store(
+            tag_ptr + region_slot,
+            cache_slot.to(tl.int32),
+            mask=owner & (kv_head == 0),
+        )
+
+        # The row cache holds the stored bytes; dequantize after the stores.
+        if IS_FP8:
+            # E4M3 bytes -> BF16 through the table (exact); see _qsa_fp8_e4m3_lut.
+            keys = tl.load(lut_ptr + keys.to(tl.uint8, bitcast=True).to(tl.int32))
+            values = tl.load(lut_ptr + values.to(tl.uint8, bitcast=True).to(tl.int32))
+        scores = tl.dot(query, keys)
+        scores *= score_scale
+        scores = tl.where(valid[None, :], scores, -1.0e20)
+        next_max = tl.maximum(max_value, tl.max(scores, axis=1))
+        alpha = tl.math.exp2(max_value - next_max)
+        probabilities = tl.where(
+            valid[None, :], tl.math.exp2(scores - next_max[:, None]), 0.0
+        )
+        accumulator = tl.dot(
+            probabilities.to(values.dtype),
+            values,
+            acc=accumulator * alpha[:, None],
+        )
+        normalizer = normalizer * alpha + tl.sum(probabilities, axis=1)
+        max_value = next_max
+
+    has_values = normalizer > 0
+    normalized_output = tl.where(
+        has_values[:, None],
+        accumulator * (output_scale / tl.maximum(normalizer[:, None], 1.0e-20)),
+        0.0,
+    )
+    output_mask = head_offsets[:, None] < GROUP_SIZE
+    if NUM_SPLITS == 1:
+        # Same gate epilogue as _qsa_sparse_paged_gqa_splitk_kernel.
+        normalized_output = normalized_output.to(output_ptr.dtype.element_ty)
+        output_gate = tl.load(
+            output_gate_ptr
+            + row * stride_output_gate_row
+            + (first_head + head_offsets[:, None]) * stride_output_gate_head
+            + dim_offsets[None, :],
+            mask=output_mask,
+            other=0.0,
+        ).to(tl.float32)
+        normalized_output = normalized_output.to(tl.float32) * tl.sigmoid(output_gate)
+        tl.store(
+            output_ptr
+            + row * stride_output_row
+            + (first_head + head_offsets[:, None]) * stride_output_head
+            + dim_offsets[None, :],
+            normalized_output,
+            mask=output_mask,
+        )
+    else:
+        partial_lse = tl.where(
+            has_values,
+            max_value + tl.math.log2(tl.maximum(normalizer, 1.0e-20)),
+            -float("inf"),
+        )
+        partial_row = (split_id * num_rows + row).to(tl.int64)
+        tl.store(
+            partial_output_ptr
+            + (partial_row * NUM_QUERY_HEADS + first_head + head_offsets[:, None])
+            * HEAD_DIM
+            + dim_offsets[None, :],
+            normalized_output,
+            mask=output_mask,
+        )
+        tl.store(
+            partial_lse_ptr + partial_row * NUM_QUERY_HEADS + first_head + head_offsets,
+            partial_lse,
+            mask=head_offsets < GROUP_SIZE,
+        )
+
+
+class QSARowCache:
+    """The staging arena reused as a per-layer K/V row cache between prefills.
+
+    Holds no memory of its own apart from the tags (4 B per slot and layer) and
+    two per-slot bid arrays shared by the layers of the rank.
+    """
+
+    _PLAN_BLOCK = 256
+    _INVALIDATE_BLOCK = 256
+
+    def __init__(
+        self, arena: torch.Tensor, num_layers: int, owns_memory: bool = False
+    ):
+        # local-50: True when the rows live in a buffer of their own
+        # (qsa_get_own_row_cache) rather than in the staging arena, so staged
+        # prefills leave them alone.
+        self.owns_memory = owns_memory
+        pages, num_kv_heads, page_size, row_width = arena.shape
+        self.num_layers = num_layers
+        self.num_kv_heads = num_kv_heads
+        self.num_slots = pages * page_size // num_layers
+        self.rows = arena.view(-1, row_width)
+        self.tags = torch.full(
+            (num_layers, self.num_slots), -1, dtype=torch.int32, device=arena.device
+        )
+        self.claim = torch.zeros(self.num_slots, dtype=torch.int64, device=arena.device)
+        self.hitmark = torch.zeros_like(self.claim)
+        self.epoch = torch.zeros(1, dtype=torch.int64, device=arena.device)
+        self._layers: dict[str, int] = {}
+
+    def add_layer(self, layer_name: str) -> int | None:
+        if layer_name not in self._layers:
+            if len(self._layers) >= self.num_layers:
+                return None
+            self._layers[layer_name] = len(self._layers)
+        return self._layers[layer_name]
+
+    def region(self, layer_index: int) -> torch.Tensor:
+        size = self.num_slots * self.num_kv_heads
+        return self.rows[layer_index * size : (layer_index + 1) * size]
+
+    def invalidate_all(self) -> None:
+        self.tags.fill_(-1)
+
+    def invalidate(self, layer_index: int, slot_mapping: torch.Tensor) -> None:
+        count = slot_mapping.shape[0]
+        _qsa_row_cache_invalidate_kernel[
+            (max(1, triton.cdiv(count, self._INVALIDATE_BLOCK)),)
+        ](
+            slot_mapping,
+            self.tags[layer_index],
+            self.epoch,
+            count,
+            NUM_SLOTS=self.num_slots,
+            BLOCK=self._INVALIDATE_BLOCK,
+            num_warps=4,
+        )
+
+
+_QSA_ROW_CACHES: dict[int, QSARowCache] = {}
+# Below this many rows per layer (two selections' worth) the cache would
+# mostly evict itself.
+_QSA_ROW_CACHE_MIN_SLOTS = 4096
+
+
+def qsa_get_row_cache(
+    arena: torch.Tensor, num_layers: int
+) -> QSARowCache | None:
+    """Return the row cache that lives in ``arena`` (one per rank).
+
+    None if the arena holds fewer than _QSA_ROW_CACHE_MIN_SLOTS rows per layer.
+    """
+    rows = arena.shape[0] * arena.shape[2]
+    if num_layers < 1 or rows // num_layers < _QSA_ROW_CACHE_MIN_SLOTS:
+        return None
+    key = arena.data_ptr()
+    cache = _QSA_ROW_CACHES.get(key)
+    if cache is None:
+        cache = QSARowCache(arena, num_layers)
+        _QSA_ROW_CACHES[key] = cache
+        from vllm.logger import init_logger
+
+        init_logger(__name__).info(
+            "QSA row cache: %d rows per layer for %d layers in the %.0f MiB "
+            "staging arena on %s",
+            cache.num_slots, num_layers,
+            arena.numel() * arena.element_size() / 2**20, arena.device,
+        )
+    return cache
+
+
+_QSA_OWN_ROW_CACHES: dict[torch.device, QSARowCache | None] = {}
+
+
+def qsa_get_own_row_cache(
+    kv_cache: torch.Tensor, cache_bytes: int, num_layers: int
+) -> QSARowCache | None:
+    """local-50: the decode row cache in a VRAM buffer of its own (one per rank).
+
+    The arena-backed cache loses every row at each staged prefill, so decodes
+    running next to a long prefill read all their rows from host memory again.
+    None if the buffer holds fewer than _QSA_ROW_CACHE_MIN_SLOTS rows per layer
+    or does not fit.
+    """
+    device = kv_cache.device
+    if device in _QSA_OWN_ROW_CACHES:
+        return _QSA_OWN_ROW_CACHES[device]
+    from vllm.logger import init_logger
+
+    logger = init_logger(__name__)
+    num_kv_heads, row_width = kv_cache.shape[1], kv_cache.shape[3]
+    row_bytes = num_kv_heads * row_width * kv_cache.element_size()
+    rows = cache_bytes // max(row_bytes, 1)
+    cache = None
+    if num_layers >= 1 and rows // num_layers >= _QSA_ROW_CACHE_MIN_SLOTS:
+        try:
+            buffer = torch.empty(
+                (1, num_kv_heads, rows, row_width),
+                dtype=kv_cache.dtype,
+                device=device,
+            )
+        except torch.OutOfMemoryError:
+            logger.warning(
+                "QSA own row cache of %.0f MiB does not fit on %s; decode reads "
+                "host K/V directly.", cache_bytes / 2**20, device,
+            )
+        else:
+            cache = QSARowCache(buffer, num_layers, owns_memory=True)
+            _QSA_ROW_CACHES[buffer.data_ptr()] = cache
+            logger.info(
+                "QSA own row cache: %d rows per layer for %d layers, %.0f MiB "
+                "on %s", cache.num_slots, num_layers,
+                buffer.numel() * buffer.element_size() / 2**20, device,
+            )
+    else:
+        logger.warning(
+            "QSA own row cache of %.0f MiB holds fewer than %d rows per layer "
+            "for %d layers on %s; not used.",
+            cache_bytes / 2**20, _QSA_ROW_CACHE_MIN_SLOTS, num_layers, device,
+        )
+    _QSA_OWN_ROW_CACHES[device] = cache
+    return cache
+
+
+def qsa_sparse_paged_attention_cached(
+    q: torch.Tensor,
+    k_cache: torch.Tensor,
+    v_cache: torch.Tensor,
+    logical_indices: torch.Tensor,
+    block_table: torch.Tensor,
+    token_to_req: torch.Tensor,
+    use_prefill_config: bool,
+    out: torch.Tensor,
+    row_cache: QSARowCache,
+    layer_index: int,
+    *,
+    output_gate: torch.Tensor,
+    k_scale: float | None = None,
+    v_scale: float | None = None,
+) -> torch.Tensor:
+    """qsa_sparse_paged_attention through the row cache. Same contract.
+
+    The caller must have run ``row_cache.invalidate`` for this layer's K/V
+    writes of this step first.
+    """
+    assert output_gate.is_contiguous()
+    output_gate_view = output_gate.view_as(q)
+    if not q.shape[0]:
+        return out
+    k_cache, is_fp8 = _qsa_fp8_bytes(k_cache)
+    v_cache, _ = _qsa_fp8_bytes(v_cache)
+    assert k_cache.dtype == v_cache.dtype == row_cache.rows.dtype
+    softmax_scale, output_scale = _qsa_scales(q.shape[2], is_fp8, k_scale, v_scale)
+    lut = _qsa_fp8_e4m3_lut(q.device) if is_fp8 else q
+    group_size = q.shape[1] // k_cache.shape[2]
+    selection_width = logical_indices.shape[1] - 1
+    block_n, partial_warps, num_tiles, num_splits = _select_config(
+        q.shape[0], k_cache.shape[2], use_prefill_config, selection_width, is_fp8
+    )
+    tags = row_cache.tags[layer_index]
+    plan_block = QSARowCache._PLAN_BLOCK
+    _qsa_row_cache_plan_kernel[
+        (q.shape[0], triton.cdiv(selection_width, plan_block))
+    ](
+        logical_indices,
+        block_table,
+        token_to_req,
+        tags,
+        row_cache.claim,
+        row_cache.hitmark,
+        row_cache.epoch,
+        logical_indices.stride(0),
+        block_table.stride(0),
+        k_cache.shape[0],
+        block_table.shape[0],
+        TOPK=selection_width,
+        PAGE_SIZE=k_cache.shape[1],
+        PAGE_TABLE_WIDTH=block_table.shape[1],
+        NUM_SLOTS=row_cache.num_slots,
+        BLOCK=plan_block,
+        num_warps=4,
+    )
+
+    if num_splits == 1:
+        partial_output = out
+        partial_lse = out
+    else:
+        partial_output = torch.empty(
+            (num_splits, *q.shape), dtype=torch.float32, device=q.device
+        )
+        partial_lse = torch.empty(
+            (num_splits, q.shape[0], q.shape[1]),
+            dtype=torch.float32,
+            device=q.device,
+        )
+    _qsa_sparse_paged_gqa_cached_kernel[(q.shape[0], k_cache.shape[2], num_splits)](
+        q,
+        k_cache,
+        v_cache,
+        logical_indices,
+        block_table,
+        token_to_req,
+        partial_output,
+        partial_lse,
+        out,
+        output_gate_view,
+        softmax_scale,
+        output_scale,
+        lut,
+        row_cache.region(layer_index),
+        tags,
+        row_cache.claim,
+        row_cache.hitmark,
+        row_cache.epoch,
+        q.stride(0),
+        q.stride(1),
+        k_cache.stride(0),
+        k_cache.stride(1),
+        k_cache.stride(2),
+        v_cache.stride(0),
+        v_cache.stride(1),
+        v_cache.stride(2),
+        logical_indices.stride(0),
+        block_table.stride(0),
+        out.stride(0),
+        out.stride(1),
+        output_gate_view.stride(0),
+        output_gate_view.stride(1),
+        q.shape[0],
+        k_cache.shape[0],
+        block_table.shape[0],
+        TOPK=selection_width,
+        PAGE_SIZE=k_cache.shape[1],
+        PAGE_TABLE_WIDTH=block_table.shape[1],
+        GROUP_SIZE=group_size,
+        HEAD_DIM=q.shape[2],
+        NUM_KV_HEADS=k_cache.shape[2],
+        NUM_QUERY_HEADS=q.shape[1],
+        NUM_SLOTS=row_cache.num_slots,
+        NUM_SPLITS=num_splits,
+        NUM_TILES=num_tiles,
+        BLOCK_M=triton.next_power_of_2(group_size),
+        BLOCK_N=block_n,
+        IS_FP8=is_fp8,
+        num_warps=partial_warps,
+        num_stages=2,
