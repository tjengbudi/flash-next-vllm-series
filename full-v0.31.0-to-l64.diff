+        self._pools = pools
+        self._group_pool = group_pool
+        self._pool_offsets = pool_offsets
+
+    def _pool_of(self, key: OffloadKey) -> int:
+        return self._group_pool.get(get_offload_group_idx(key), 0)
+
+    def _split(self, keys: Iterable[OffloadKey]) -> dict[int, list[OffloadKey]]:
+        split: dict[int, list[OffloadKey]] = {}
+        for key in keys:
+            split.setdefault(self._pool_of(key), []).append(key)
+        return split
+
+    def _ctx(self, req_context: ReqContext, pool: int):
+        return _PoolReqContext(req_context, pool)
+
+    def _merge_ids(
+        self,
+        keys: list[OffloadKey],
+        per_pool: dict[int, tuple[list[OffloadKey], LoadStoreSpec]],
+    ) -> CPULoadStoreSpec:
+        ids: dict[OffloadKey, int] = {}
+        for pool, (pool_keys, spec) in per_pool.items():
+            assert isinstance(spec, CPULoadStoreSpec)
+            offset = self._pool_offsets[pool]
+            for key, chunk_id in zip(pool_keys, spec.block_ids):
+                ids[key] = int(chunk_id) + offset
+        return CPULoadStoreSpec([ids[key] for key in keys])
+
+    @override
+    def on_new_request(self, req_context: ReqContext) -> RequestOffloadingContext:
+        for pool, manager in enumerate(self._pools):
+            manager.on_new_request(self._ctx(req_context, pool))
+        return RequestOffloadingContext()
+
+    @override
+    def lookup(self, key: OffloadKey, req_context: ReqContext) -> LookupResult:
+        pool = self._pool_of(key)
+        return self._pools[pool].lookup(key, self._ctx(req_context, pool))
+
+    @override
+    def prepare_load(
+        self,
+        keys: Collection[OffloadKey],
+        req_context: ReqContext,
+    ) -> LoadStoreSpec:
+        keys = list(keys)
+        per_pool = {
+            pool: (
+                pool_keys,
+                self._pools[pool].prepare_load(pool_keys, self._ctx(req_context, pool)),
+            )
+            for pool, pool_keys in self._split(keys).items()
+        }
+        return self._merge_ids(keys, per_pool)
+
+    @override
+    def touch(self, keys: Collection[OffloadKey], req_context: ReqContext) -> None:
+        for pool, pool_keys in self._split(keys).items():
+            self._pools[pool].touch(pool_keys, self._ctx(req_context, pool))
+
+    @override
+    def complete_load(
+        self, keys: Collection[OffloadKey], req_context: ReqContext
+    ) -> None:
+        for pool, pool_keys in self._split(keys).items():
+            self._pools[pool].complete_load(pool_keys, self._ctx(req_context, pool))
+
+    @override
+    def prepare_store(
+        self,
+        keys: Collection[OffloadKey],
+        req_context: ReqContext,
+    ) -> PrepareStoreOutput | None:
+        keys = list(keys)
+        outputs: dict[int, PrepareStoreOutput] = {}
+        for pool, pool_keys in self._split(keys).items():
+            output = self._pools[pool].prepare_store(
+                pool_keys, self._ctx(req_context, pool)
+            )
+            if output is None:
+                # All or nothing: release what the other pools reserved.
+                for done_pool, done in outputs.items():
+                    self._pools[done_pool].complete_store(
+                        done.keys_to_store,
+                        self._ctx(req_context, done_pool),
+                        success=False,
+                    )
+                return None
+            outputs[pool] = output
+        to_store = {key for out in outputs.values() for key in out.keys_to_store}
+        keys_to_store = [key for key in keys if key in to_store]
+        store_spec = self._merge_ids(
+            keys_to_store,
+            {
+                pool: (out.keys_to_store, out.store_spec)
+                for pool, out in outputs.items()
+            },
+        )
+        return PrepareStoreOutput(
+            keys_to_store=keys_to_store,
+            store_spec=store_spec,
+            evicted_keys=[key for out in outputs.values() for key in out.evicted_keys],
+        )
+
+    @override
+    def complete_store(
+        self,
+        keys: Collection[OffloadKey],
+        req_context: ReqContext,
+        success: bool = True,
+    ) -> None:
+        for pool, pool_keys in self._split(keys).items():
+            self._pools[pool].complete_store(
+                pool_keys, self._ctx(req_context, pool), success=success
+            )
+
+    @override
+    def on_request_finished(self, req_context: ReqContext) -> None:
+        for pool, manager in enumerate(self._pools):
+            manager.on_request_finished(self._ctx(req_context, pool))
+
+    @override
+    def on_schedule_end(self, context) -> None:
+        for manager in self._pools:
+            manager.on_schedule_end(context)
+
+    @override
+    def has_pending_work(self) -> bool:
+        return any(manager.has_pending_work() for manager in self._pools)
+
+    @override
+    def reset_cache(self) -> None:
+        for manager in self._pools:
+            manager.reset_cache()
+
+    @override
+    def take_events(self) -> Iterable[OffloadingEvent]:
+        for manager in self._pools:
+            yield from manager.take_events()
+
+    def get_stats(self) -> OffloadingConnectorStats | None:
+        # Every pool clears its per-step counters; report the first pool
+        # (the largest host rows), which fills up first.
+        stats = [manager.get_stats() for manager in self._pools]
+        return stats[0]
+
+    @override
+    def shutdown(self) -> None:
+        for manager in self._pools:
+            manager.shutdown()
