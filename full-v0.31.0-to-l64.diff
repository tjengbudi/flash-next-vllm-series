+def _ple_env_int(name: str, default: int, lo: int) -> int:
+    try:
+        return max(lo, int(os.environ.get(name, str(default)).strip() or default))
+    except ValueError:
+        return default
+
+
+_PLE_ADVISE_THREADS = _ple_env_int("VLLM_PLE_ADVISE_THREADS", 1, 1)
+_PLE_ADVISE_SPLIT_MIN = _ple_env_int("VLLM_PLE_ADVISE_SPLIT_MIN", 16, 1)
+_PLE_PREFETCH_BATCH_ENV = "VLLM_PLE_PREFETCH_BATCH"  # tokens per advise batch
