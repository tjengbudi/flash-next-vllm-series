+        self,
+        input_batch: InputBatch,
+        attn_metadata: dict[str, Any],
+        slot_mappings: dict[str, torch.Tensor],
+        last_hidden_states: torch.Tensor,
+        aux_hidden_states: list[torch.Tensor] | None,
+        num_sampled: torch.Tensor,
+        num_rejected: torch.Tensor,
+        last_sampled: torch.Tensor,
+        next_prefill_tokens: torch.Tensor,
+        temperature: torch.Tensor,
+        seeds: torch.Tensor,
+        dp_sync: DPSyncState | None = None,
+        dummy_run: bool = False,
+        skip_attn_for_dummy_run: bool = False,
+        mm_inputs: tuple[list[torch.Tensor], torch.Tensor] | None = None,
+        is_profile: bool = False,
+    ) -> torch.Tensor:
+        use_lookup = (
+            input_batch.num_reqs == 1
+            and not dummy_run
+            # local-35: and no other request running on this worker.
+            and (not self.single_only or self.req_states.num_reqs == 1)
+        )
+        if use_lookup:
+            ngram_drafts, has_match = self.ngram.lookup(
+                self.req_states,
+                input_batch.idx_mapping,
+                num_sampled,
+                last_sampled,
+                1,
+            )
+            if self.predict_wait:
+                self._predictive_wait(input_batch.req_ids[0], has_match)
+            else:
+                self.matched_cpu.copy_(has_match, non_blocking=True)
+                self.matched_event.record()
+                self.wait_for_lookup = True
+
+        draft_tokens = super().propose(
+            input_batch,
+            attn_metadata,
+            slot_mappings,
+            last_hidden_states,
+            aux_hidden_states,
+            num_sampled,
+            num_rejected,
+            last_sampled,
+            next_prefill_tokens,
+            temperature,
+            seeds,
+            dp_sync=dp_sync,
+            dummy_run=dummy_run,
+            skip_attn_for_dummy_run=skip_attn_for_dummy_run,
+            mm_inputs=mm_inputs,
+            is_profile=is_profile,
+        )
+        self.wait_for_lookup = False
+        if not use_lookup:
+            return draft_tokens
+        torch.where(has_match[:, None], ngram_drafts, draft_tokens, out=draft_tokens)
+        if self.draft_logits is not None:
+            write_one_hot_draft_logits(
+                self.draft_logits, input_batch.idx_mapping, has_match, ngram_drafts
+            )
+        return draft_tokens
