+        kv_cache,
+        logical_indices,
+        attn_metadata.block_table[best],
+        rows,
+        max_logical_page,
+        arena,
+        use_prefill_config,
+        output[:num_tokens],
+        output_gate=output_gate[:num_tokens],
+        k_scale=layer._k_scale_float,
+        v_scale=layer._v_scale_float,
+        host_kv=host_kv,
+        physical_pages=physical_pages,
