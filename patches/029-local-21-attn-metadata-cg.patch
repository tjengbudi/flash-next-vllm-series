+class _KeepPinnedH2D:
+    """While recording, stage every ``async_tensor_h2d`` source in a pinned
+    tensor kept alive with the graph: its memcpy node re-reads that host address
+    on each replay, so the bytes must neither be freed nor reused. Recorded
+    values are fixed by the batch shape (e.g. the all-spec-decode mask)."""
+
+    def __init__(self, keep: list[torch.Tensor]) -> None:
+        self.keep = keep
+        self.patched: list[Any] = []
+
+    def __enter__(self) -> "_KeepPinnedH2D":
+        from vllm.utils import torch_utils
+
+        orig = torch_utils.async_tensor_h2d
+        keep = self.keep
+
+        def h2d(data, device=None, dtype=None, out=None):
+            if dtype is None and out is not None:
+                dtype = out.dtype
+            if isinstance(data, np.ndarray):
+                data = torch.from_numpy(data)
+            if isinstance(data, torch.Tensor):
+                t = torch.empty(
+                    data.shape, dtype=dtype or data.dtype, pin_memory=True
+                ).copy_(data)
+            else:
+                t = torch.tensor(data, dtype=dtype, pin_memory=True)
+            keep.append(t)
+            if out is not None:
+                return out.copy_(t, non_blocking=True)
+            return t.to(device=device, dtype=dtype, non_blocking=True)
+
+        self.orig = orig
+        for name, mod in list(sys.modules.items()):
+            if (
+                name.startswith("vllm")
+                and mod is not None
+                and getattr(mod, "async_tensor_h2d", None) is orig
+            ):
+                mod.async_tensor_h2d = h2d
+                self.patched.append(mod)
+        return self
+
+    def __exit__(self, *exc) -> None:
+        for mod in self.patched:
+            mod.async_tensor_h2d = self.orig
+        self.patched.clear()
+
 
