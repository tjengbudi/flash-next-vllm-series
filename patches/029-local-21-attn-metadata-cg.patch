+# local-21: FULL uniform spec-decode steps replay a CUDA graph of their
+# attention-metadata build (recorded at the end of CUDA graph capture, one per
+# batch shape) instead of rebuilding ~20 KV cache groups in Python. Off unless
+# VLLM_CG_ATTN_META=1, which leaves the l15 code path untouched.
+_CG_ATTN_META = os.environ.get("VLLM_CG_ATTN_META", "0") == "1"
