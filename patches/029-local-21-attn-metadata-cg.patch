+    def _cg_meta_key(self, input_batch: InputBatch) -> tuple[int, int, int, int] | None:
+        """Key of a FULL step whose metadata build a recording can replay: every
+        request a spec decode of exactly num_spec drafts, as recorded."""
+        if input_batch.has_prefill or input_batch.max_query_len is not None:
+            return None
+        n = input_batch.num_reqs
+        if input_batch.idx_mapping.shape[0] != n:
+            return None
+        if (
+            input_batch.prefill_runs_as_decode_np is not None
+            and input_batch.prefill_runs_as_decode_np[:n].any()
+        ):
+            return None
+        if input_batch.is_prefilling_np[:n].any():
+            return None
+        q = self._cg_meta_qlen
+        if not (input_batch.num_scheduled_tokens[:n] == q).all():
+            return None
+        nd = input_batch.num_draft_tokens_per_req
+        if nd is None or not (nd[:n] == q - 1).all():
+            return None
+        return (
+            n,
+            input_batch.num_reqs_after_padding,
+            input_batch.num_tokens,
+            input_batch.num_tokens_after_padding,
+        )
+
+    def _cg_meta_replay(self, input_batch: InputBatch) -> dict[str, Any] | None:
+        key = self._cg_meta_key(input_batch)
+        entry = self._cg_meta_graphs.get(key) if key is not None else None
+        if entry is not None and self._align_mode:
+            ctx = self._mamba_ctx
+            # The recording read the source block tables through the bound
+            # pointer array with this row stride; preprocess_state (re)binds it
+            # before every real step.
+            if (
+                ctx is None
+                or not ctx.is_initialized
+                or ctx.block_table_stride_req != self._cg_meta_stride
+            ):
+                entry = None
+        if entry is None:
+            self._cg_meta_misses += 1
+            return None
+        n = input_batch.num_reqs
+        self._cg_meta_idx[:n].copy_(input_batch.idx_mapping, non_blocking=True)
+        graph, attn_metadata = entry
+        graph.replay()
+        self._cg_meta_hits += 1
+        if (self._cg_meta_hits & 0x3FFF) == 0:
+            logger.info(
+                "local-21: metadata replays %d, eager FULL builds %d",
+                self._cg_meta_hits,
+                self._cg_meta_misses,
+            )
+        return attn_metadata
+
+    def record_decode_attn_metadata(
+        self,
+        input_buffers: Any,
+        block_tables: Any,
+        attn_groups: list[list[AttentionGroup]],
+        kv_cache_config: KVCacheConfig,
+        cudagraph_manager: Any,
+    ) -> None:
+        """local-21: record the metadata build of every uniform spec-decode
+        shape a FULL graph serves. Called once the forward graphs are captured."""
+        if not self._cg_meta_enabled:
+            return
+        self._cg_meta_graphs.clear()
+        self._cg_meta_keep.clear()
+        if self.vllm_config.compilation_config.cudagraph_mode.decode_mode() != (
+            CUDAGraphMode.FULL
+        ):
+            return
+        q = self._cg_meta_qlen
+        keys: list[tuple[int, int, int, int]] = []
+        for n in range(1, self.max_num_reqs + 1):
+            desc = cudagraph_manager.dispatch(
+                num_reqs=n, num_tokens=n * q, uniform_token_count=q, num_active_loras=0
+            )
+            if desc.cg_mode != CUDAGraphMode.FULL or desc.num_ubatches != 1:
+                continue
+            keys.append((n, desc.num_reqs or n, n * q, desc.num_tokens))
+        if not keys:
+            logger.warning("local-21: no FULL uniform decode shapes to record")
+            return
+
+        ctx = None
+        if self._align_mode:
+            # Bind the align context to the SOURCE per-request-slot tables now,
+            # so the recording reads them through the pointer array (and no
+            # binding write lands inside a graph). Released afterwards: the first
+            # real batch binds the same tables again, as without local-21.
+            mamba_group_ids, _ = self._get_mamba_group_info(kv_cache_config)
+            if self._mamba_ctx is not None:
+                self._mamba_ctx.is_initialized = False
+            ctx, _ = self._ensure_align_ctx(
+                kv_cache_config,
+                mamba_group_ids,
+                tuple(bt.gpu for bt in block_tables.block_tables),
+                bind=True,
+            )
+            self._cg_meta_stride = ctx.block_table_stride_req
+
+        if self._cg_meta_pool is None:
+            self._cg_meta_pool = torch.cuda.graph_pool_handle()
+        self._cg_meta_recording = True
+        try:
+            for key in keys:
+                try:
+                    self._cg_meta_record_one(
+                        key, input_buffers, block_tables, attn_groups, kv_cache_config
+                    )
+                except Exception as e:  # keep serving with the eager build
+                    self._cg_meta_graphs.pop(key, None)
+                    logger.warning(
+                        "local-21: recording metadata build %s failed: %r", key, e
+                    )
+        finally:
+            self._cg_meta_recording = False
+            if ctx is not None:
+                ctx.is_initialized = False
+        torch.accelerator.synchronize()
+        logger.info(
+            "local-21: recorded attention-metadata builds for %s",
+            sorted(self._cg_meta_graphs),
+        )
+
+    def _cg_meta_record_one(
+        self,
+        key: tuple[int, int, int, int],
+        input_buffers: Any,
+        block_tables: Any,
+        attn_groups: list[list[AttentionGroup]],
+        kv_cache_config: KVCacheConfig,
+    ) -> None:
+        n, n_pad, t, t_pad = key
+        q = self._cg_meta_qlen
+        dummy = InputBatch.make_dummy(n, t, input_buffers)
+        qsl_np = np.full(n_pad + 1, t, dtype=np.int32)
+        qsl_np[: n + 1] = np.arange(n + 1, dtype=np.int32) * q
+        input_buffers.query_start_loc[: n_pad + 1].copy_(torch.from_numpy(qsl_np))
+        input_buffers.seq_lens[n:].zero_()
+        batch = replace(
+            dummy,
+            num_reqs_after_padding=n_pad,
+            num_tokens_after_padding=t_pad,
+            idx_mapping=self._cg_meta_idx[:n],
+            num_scheduled_tokens=np.full(n, q, dtype=np.int32),
+            num_draft_tokens=n * (q - 1),
+            num_draft_tokens_per_req=np.full(n, q - 1, dtype=np.int32),
+            query_start_loc=input_buffers.query_start_loc[: n_pad + 1],
+            query_start_loc_np=qsl_np,
+            seq_lens=input_buffers.seq_lens[:n_pad],
+            # Worst case, as at capture: bounds host values only.
+            seq_lens_cpu_upper_bound=torch.full(
+                (n_pad,), self.max_model_len, dtype=torch.int32
+            ),
+            is_prefilling_np=np.zeros(n, dtype=np.bool_),
+            has_prefill=False,
+            prefill_runs_as_decode_np=None,
+            max_query_len=None,
+            input_ids=input_buffers.input_ids[:t_pad],
+            positions=input_buffers.positions[:t_pad],
+            is_padding=input_buffers.is_padding[:t_pad],
+        )
+        assert self._cg_meta_key(batch) == key, (self._cg_meta_key(batch), key)
+        self._cg_meta_idx.zero_()
+        tables = block_tables.get_dummy_block_tables(n_pad)
+        slots = block_tables.get_dummy_slot_mappings(t_pad)
+
+        def build() -> dict[str, Any]:
+            return self.prepare_attn(
+                batch,
+                CUDAGraphMode.FULL,
+                tables,
+                slots,
+                attn_groups,
+                kv_cache_config,
+            )
+
+        build()  # warm lazy allocations / kernel compiles outside the graph
+        torch.accelerator.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with (
+            _KeepPinnedH2D(self._cg_meta_keep),
+            torch.cuda.graph(graph, pool=self._cg_meta_pool),
+            warnings.catch_warnings(),
+        ):
+            warnings.filterwarnings("ignore", message="The CUDA Graph is empty")
+            attn_metadata = build()
+        self._cg_meta_graphs[key] = (graph, attn_metadata)
+
