+    def _sampling_key(self, n: int, idx_np: np.ndarray) -> tuple | None:
+        ss = self.ss
+        if int(np.max(ss.num_logprobs[idx_np])) != NO_LOGPROBS:
+            return None
+        if not np.any(self.sampler.needs_logits_processing[idx_np]):
+            return (n, False)
+        # Mirror apply_sampling_params: the logits processors must all skip.
+        tb = self.sampler.thinking_budget_state
+        if (
+            np.any(self.logit_bias.use_logit_bias[idx_np])
+            or np.any(self.penalties.use_penalty[idx_np])
+            or int(self.bad_words.num_bad_words.np[idx_np].max()) != 0
+            or (tb.enabled and np.any(tb.use_thinking_budget[idx_np]))
+        ):
+            return None
+        temp = ss.temperature.np[idx_np]
+        do_temp = not bool(np.all((temp == 0.0) | (temp == 1.0)))
+        do_min_p = not bool(np.all(ss.min_p.np[idx_np] == 0.0))
+        top_k = ss.top_k.np[idx_np]
+        top_p = ss.top_p.np[idx_np]
+        do_top_k = bool(np.any(top_k != ss.vocab_size))
+        do_top_p = bool(np.any(top_p != 1.0))
+        topp_only = bool(do_top_p and np.any((top_k >= self.vocab) & (top_p < 1.0)))
