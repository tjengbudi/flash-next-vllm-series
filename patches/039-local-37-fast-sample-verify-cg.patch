+    ) -> SamplerOutput | None:
+        key = self._key(logits, ib, draft_logits)
+        if key is None or key in self.bad:
+            self.stats["eager"] += 1
+            return None
+        entry = self.graphs.get(key)
+        check = False
+        if entry is None:
+            seen = self.seen.get(key, 0) + 1
+            self.seen[key] = seen
+            if seen < 2 or len(self.graphs) >= _FS_MAX_GRAPHS:
+                # First sight: the eager step compiles the kernels and sizes
+                # the top-k/top-p workspaces outside any capture.
+                self.stats["eager"] += 1
+                return None
+            try:
+                entry = self._capture(key)
+            except Exception as e:  # keep serving eagerly
+                logger.warning("local-37: recording verify %s failed: %r", key, e)
+                self.bad.add(key)
+                self.stats["bad"] += 1
+                return None
+            self.graphs[key] = entry
+            self.stats["captures"] += 1
