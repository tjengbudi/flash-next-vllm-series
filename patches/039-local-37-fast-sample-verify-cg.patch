+    def _key(
+        self, logits: torch.Tensor, ib: InputBatch, draft_logits: torch.Tensor | None
+    ) -> tuple | None:
+        n = ib.num_reqs
+        nl = n * self.q
+        if (
+            draft_logits is not None
+            or n <= 0
+            or n > self.max_reqs
+            or ib.num_tokens != nl
+            or ib.num_draft_tokens != n * self.nspec
+            or logits.shape[0] != nl
+            or logits.shape[1] != self.vocab
+            or logits.dtype != self.dtype
+            or ib.idx_mapping.shape[0] != n
+        ):
+            return None
+        ptrs = (
+            ib.input_ids.data_ptr(),
+            ib.positions.data_ptr(),
+            ib.seq_lens.data_ptr(),
+        )
+        if self.ptrs is None:
+            self.ptrs = ptrs
+            self.bufs = (ib.input_ids, ib.positions, ib.seq_lens)
+        elif ptrs != self.ptrs:
+            return None
+        idx_np = ib.idx_mapping_np
+        if self.key_version != self.version:
+            self.key_cache.clear()
+            self.key_version = self.version
+        cache_key = idx_np.tobytes()
+        key = self.key_cache.get(cache_key, False)
+        if key is False:
+            key = self._sampling_key(n, idx_np)
+            self.key_cache[cache_key] = key
+        return key
