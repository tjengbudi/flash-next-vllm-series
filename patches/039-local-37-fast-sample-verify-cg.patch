+class _FastVerify:
+    """local-37: recorded CUDA graphs of the decode verify step.
+
+    Every input the graph reads sits at a fixed address: the logits and
+    idx_mapping are copied into static buffers each step; the per-request
+    sampling tables (UVA, re-pointed on every staged write) are mirrored into
+    device tables after any add_request wrote them; input_ids / positions /
+    seq_lens are the model runner's persistent buffers (checked by pointer).
+    """
+
+    _TABLES = ("temperature", "seeds", "top_k", "top_p", "min_p")
+
+    def __init__(self, rs: "RejectionSampler", logits: torch.Tensor):
+        sampler = rs.sampler
+        self.rs = rs
+        self.sampler = sampler
+        ss = sampler.sampling_states
+        self.ss = ss
+        self.max_reqs = ss.max_num_reqs
+        self.nspec = rs.num_speculative_steps
+        self.q = self.nspec + 1
+        self.vocab = logits.shape[1]
+        self.dtype = logits.dtype
+        dev = logits.device
+        self.device = dev
+        m = self.max_reqs * self.q
+        self.logits_s = torch.zeros(m, self.vocab, dtype=self.dtype, device=dev)
+        self.idx_s = torch.zeros(self.max_reqs, dtype=torch.int32, device=dev)
+        # Per-n destination views of the per-step input copies (slicing costs
+        # host time too).
+        self.in_views = [
+            [self.logits_s[: n * self.q], self.idx_s[:n]]
+            for n in range(self.max_reqs + 1)
+        ]
+        ar = torch.arange(m, dtype=torch.int64, device=dev)
+        self.rep_c = ar // self.q
+        self.lidx_c = ar.clone()
+        self.lpos_c = (ar % self.q).to(torch.int32)
+        self.cu_c = (
+            torch.arange(self.max_reqs + 1, dtype=torch.int32, device=dev) * self.q
+        )
+        self.uva = {name: getattr(ss, name) for name in self._TABLES}
+        self.uva["prefill_len"] = sampler.req_states.prefill_len
+        self.tab = {
+            name: torch.zeros_like(t.gpu, device=dev) for name, t in self.uva.items()
+        }
+        # Every writer of these tables (and of the per-request flags the key
+        # reads) runs inside SamplingStates/RequestState.add_request: count
+        # those calls, and refresh the device mirrors / drop cached keys when
+        # the count moved.
+        self.version = 0
+        self.tab_version = -1
+        self.key_cache: dict[bytes, tuple] = {}
+        self.key_version = -1
+
+        def bump(fn):
+            def wrapped(*args, **kwargs):
+                self.version += 1
+                return fn(*args, **kwargs)
+
+            return wrapped
+
+        ss.add_request = bump(ss.add_request)
+        sampler.req_states.add_request = bump(sampler.req_states.add_request)
+        self.ptrs: tuple[int, int, int] | None = None
+        self.bufs: tuple[torch.Tensor, torch.Tensor, torch.Tensor] | None = None
+        self.graphs: dict[tuple, tuple[torch.cuda.CUDAGraph, tuple]] = {}
+        self.seen: dict[tuple, int] = {}
+        self.bad: set[tuple] = set()
+        self.keep: list[Any] = []
+        self.pool = torch.cuda.graph_pool_handle()
+        self.stream = torch.cuda.Stream(device=dev)
+        lps = sampler.logits_processors
+        self.logit_bias, self.penalties, self.bad_words = lps[0], lps[1], lps[2]
+        self.stats = {"replays": 0, "eager": 0, "captures": 0, "bad": 0}
+        rs._fs_stats = self.stats
+
+    @staticmethod
+    def supported(rs: "RejectionSampler", logits: torch.Tensor) -> bool:
+        from vllm.platforms import current_platform
+        from vllm.v1.worker.gpu.sample.bad_words import BadWordsState
+        from vllm.v1.worker.gpu.sample.logit_bias import LogitBiasState
+        from vllm.v1.worker.gpu.sample.penalties import PenaltiesState
+
+        sampler = rs.sampler
+        lps = getattr(sampler, "logits_processors", ())
+        return (
+            current_platform.is_cuda()
+            and type(sampler) is Sampler
+            and rs.watermark_key is None
+            and rs.synthetic_conditional_rates is None
+            and not rs.use_block_verification
+            and not rs.enable_adaptive_verification
