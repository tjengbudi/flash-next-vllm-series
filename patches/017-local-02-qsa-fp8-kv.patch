     return current_platform.get_device_capability() == (9, 0)
 
 
+# FP8-e4m3 main K/V on sm_86 (flash-next local-02). Upstream reads the cache
+# as float8_e4m3fn and converts it in Triton, which needs the fp8e4nv type that
+# Triton only has on sm_89+. Here every QSA kernel reads the cache as uint8 and
+# dequantizes through a 256-entry E4M3 -> BF16 table (exact), and both dots run
+# in BF16 (local-05: no FP16 converts per tile). The per-tensor k/v scales stay
+# host floats folded into softmax_scale / output_scale, as upstream does.
+_QSA_FP8_E4M3_LUT: dict[torch.device, torch.Tensor] = {}
+
+
+def _qsa_fp8_e4m3_lut(device: torch.device) -> torch.Tensor:
+    device = torch.device(device)
+    if device.type == "cuda" and device.index is None:
+        device = torch.device("cuda", torch.cuda.current_device())
+    lut = _QSA_FP8_E4M3_LUT.get(device)
+    if lut is None:
+        lut = (
+            torch.arange(256, dtype=torch.uint8)
+            .view(torch.float8_e4m3fn)
+            .to(torch.bfloat16)
+            .to(device)
+        )
+        _QSA_FP8_E4M3_LUT[device] = lut
+    return lut
+
+
+def qsa_fp8_prepare(device: torch.device) -> None:
+    """Create the per-device table outside CUDA graph capture."""
+    _qsa_fp8_e4m3_lut(device)
+
+
+def _qsa_fp8_bytes(cache: torch.Tensor) -> tuple[torch.Tensor, bool]:
+    """(cache as uint8 if it holds E4M3, whether it does)."""
+    if cache.dtype == torch.float8_e4m3fn:
+        return cache.view(torch.uint8), True
+    return cache, cache.dtype == torch.uint8
+
+
+def _qsa_scales(
+    head_dim: int, is_fp8: bool, k_scale: float | None, v_scale: float | None
+) -> tuple[float, float]:
+    """(softmax_scale with the K scale folded in, output scale = V scale)."""
+    if not is_fp8:
+        return head_dim**-0.5, 1.0
+    k = 1.0 if k_scale is None else float(k_scale)
+    v = 1.0 if v_scale is None else float(v_scale)
+    return (head_dim**-0.5) * k, v
+
