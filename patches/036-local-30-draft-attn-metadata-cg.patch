+# local-30: a FULL draft decode step replays a CUDA graph of its attention
+# metadata build (slot mappings + the draft groups' builders), recorded once per
+# batch shape at the end of CUDA graph capture, instead of rebuilding it in
+# Python. The FULL decode graph reads only the persistent buffers that build
+# writes; the returned metadata is not used. Off unless VLLM_CG_DRAFT_META=1,
+# which leaves the l24e/l29 code path untouched.
+_CG_DRAFT_META = os.environ.get("VLLM_CG_DRAFT_META", "0") == "1"
+
+
+class _RefuseH2D:
+    """While recording, fail every ``async_tensor_h2d``: its memcpy node would
+    re-send the recording-time host bytes on each replay. That shape keeps the
+    eager build instead."""
+
+    def __enter__(self) -> "_RefuseH2D":
+        from vllm.utils import torch_utils
+
+        orig = torch_utils.async_tensor_h2d
+
+        def refuse(*args, **kwargs):
+            raise RuntimeError("local-30: host-to-device copy in a draft metadata build")
+
+        self.orig = orig
+        self.patched = []
+        for name, mod in list(sys.modules.items()):
+            if (
+                name.startswith("vllm")
+                and mod is not None
+                and getattr(mod, "async_tensor_h2d", None) is orig
+            ):
+                mod.async_tensor_h2d = refuse
+                self.patched.append(mod)
+        return self
+
+    def __exit__(self, *exc) -> None:
+        for mod in self.patched:
+            mod.async_tensor_h2d = self.orig
+        self.patched.clear()
+
 
