+def qsa_copy_pages(
+    arena: torch.Tensor,
+    first_slot: int,
+    host_kv: torch.Tensor,
+    physical_pages: list[int],
+) -> None:
+    """Copy host pages into consecutive arena slots from ``first_slot`` on.
+
+    Runs of consecutive block ids become one cudaMemcpyAsync each, on the
+    current stream. ``host_kv`` is pinned (cudaHostRegister), so the copies go
+    through the copy engine and leave the SMs to the kernels around them.
+    """
+    slot = first_slot
+    index = 0
+    count = len(physical_pages)
+    while index < count:
+        start = physical_pages[index]
+        run = 1
+        while index + run < count and physical_pages[index + run] == start + run:
+            run += 1
+        arena[slot : slot + run].copy_(host_kv[start : start + run], non_blocking=True)
+        slot += run
+        index += run
+
+
+# local-50: copies of the next QSA layer's leading pages, made on a side
+# stream while the layers between the two QSA layers compute. One per device.
+_QSA_COPY_STREAMS: dict[torch.device, torch.cuda.Stream] = {}
+_QSA_PREFETCH: dict[torch.device, dict] = {}
+
+
+def qsa_prefetch_arena(
+    arena: torch.Tensor,
+    layer_name: str,
+    host_kv: torch.Tensor,
+    physical_pages: list[int],
+) -> None:
+    """Start copying ``physical_pages`` of ``layer_name`` into arena slot 0..n.
+
+    The copy waits for everything queued on the current stream so far, which
+    includes the last kernel that reads the arena. qsa_prefetch_take() must run
+    before anything else touches the arena.
+    """
+    device = arena.device
+    qsa_prefetch_fence(device)
+    if not physical_pages:
+        return
+    stream = _QSA_COPY_STREAMS.get(device)
+    if stream is None:
+        stream = torch.cuda.Stream(device=device)
+        _QSA_COPY_STREAMS[device] = stream
+    ready = torch.cuda.Event()
+    ready.record(torch.cuda.current_stream(device))
+    with torch.cuda.stream(stream):
+        stream.wait_event(ready)
+        qsa_copy_pages(arena, 0, host_kv, physical_pages)
+        done = torch.cuda.Event()
+        done.record(stream)
+    _QSA_PREFETCH[device] = {
+        "arena": arena.data_ptr(),
+        "layer": layer_name,
+        "pages": tuple(physical_pages),
+        "done": done,
+    }
+
+
+def qsa_prefetch_fence(device: torch.device) -> None:
+    """Order a pending prefetch before later work on the current stream."""
+    pending = _QSA_PREFETCH.pop(device, None)
+    if pending is not None:
+        torch.cuda.current_stream(device).wait_event(pending["done"])
+
+
+def qsa_prefetch_take(
+    arena: torch.Tensor, layer_name: str, physical_pages: list[int]
+) -> int:
+    """Fence a pending prefetch; return how many leading pages it already put
+    in the arena for this layer and request (0 if it was for something else).
+    """
+    device = arena.device
+    pending = _QSA_PREFETCH.get(device)
+    if pending is None:
+        return 0
+    qsa_prefetch_fence(device)
+    pages = pending["pages"]
+    if (
+        pending["arena"] != arena.data_ptr()
+        or pending["layer"] != layer_name
+        or tuple(physical_pages[: len(pages)]) != pages
+    ):
+        return 0
+    return len(pages)
+
+
 _QSA_ARENA_CACHE: dict[tuple, torch.Tensor | None] = {}
 
 
