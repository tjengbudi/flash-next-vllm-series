+_QSA_OWN_ROW_CACHES: dict[torch.device, QSARowCache | None] = {}
+
+
+def qsa_get_own_row_cache(
+    kv_cache: torch.Tensor, cache_bytes: int, num_layers: int
+) -> QSARowCache | None:
+    """local-50: the decode row cache in a VRAM buffer of its own (one per rank).
+
+    The arena-backed cache loses every row at each staged prefill, so decodes
+    running next to a long prefill read all their rows from host memory again.
+    None if the buffer holds fewer than _QSA_ROW_CACHE_MIN_SLOTS rows per layer
+    or does not fit.
+    """
+    device = kv_cache.device
+    if device in _QSA_OWN_ROW_CACHES:
+        return _QSA_OWN_ROW_CACHES[device]
+    from vllm.logger import init_logger
+
+    logger = init_logger(__name__)
+    num_kv_heads, row_width = kv_cache.shape[1], kv_cache.shape[3]
+    row_bytes = num_kv_heads * row_width * kv_cache.element_size()
+    rows = cache_bytes // max(row_bytes, 1)
+    cache = None
+    if num_layers >= 1 and rows // num_layers >= _QSA_ROW_CACHE_MIN_SLOTS:
+        try:
+            buffer = torch.empty(
+                (1, num_kv_heads, rows, row_width),
+                dtype=kv_cache.dtype,
+                device=device,
+            )
+        except torch.OutOfMemoryError:
+            logger.warning(
+                "QSA own row cache of %.0f MiB does not fit on %s; decode reads "
+                "host K/V directly.", cache_bytes / 2**20, device,
+            )
+        else:
+            cache = QSARowCache(buffer, num_layers, owns_memory=True)
+            _QSA_ROW_CACHES[buffer.data_ptr()] = cache
+            logger.info(
+                "QSA own row cache: %d rows per layer for %d layers, %.0f MiB "
+                "on %s", cache.num_slots, num_layers,
+                buffer.numel() * buffer.element_size() / 2**20, device,
+            )
+    else:
+        logger.warning(
+            "QSA own row cache of %.0f MiB holds fewer than %d rows per layer "
+            "for %d layers on %s; not used.",
+            cache_bytes / 2**20, _QSA_ROW_CACHE_MIN_SLOTS, num_layers, device,
+        )
+    _QSA_OWN_ROW_CACHES[device] = cache
+    return cache
+
