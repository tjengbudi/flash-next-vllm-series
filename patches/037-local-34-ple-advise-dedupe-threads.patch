+    def _advise_split(self, iov: np.ndarray, count: int, parts: int) -> int:
+        """local-34: advise ``iov[:count]`` in ``parts`` contiguous slices, the
+        first on the calling thread and the others on helper threads; wait for
+        all of them. Returns the lowest return code."""
+        helpers = self._helpers
+        if helpers is None:
+            helpers = self._helpers = _PLEAdviseHelpers(
+                self._libc, self._pidfd, self._SYS_PROCESS_MADVISE,
+                self._MADV_WILLNEED,
+            )
+        helpers.ensure(parts - 1)
+        addr = iov.ctypes.data
+        stride = iov.strides[0]
+        bounds = [count * i // parts for i in range(parts + 1)]
+        for i in range(1, parts):
+            helpers.submit(
+                i - 1, addr + bounds[i] * stride, bounds[i + 1] - bounds[i]
+            )
+        rc = self._libc.syscall(
+            self._SYS_PROCESS_MADVISE, self._pidfd,
+            ctypes.c_void_p(addr), bounds[1], self._MADV_WILLNEED, 0,
+        )
+        for _ in range(1, parts):
+            try:
+                r = helpers.done.get(timeout=1.0)
+            except queue.Empty:
+                # A helper is stuck: stop splitting (late results are ignored).
+                logger.warning("PLE advise helper timed out; advise_now stops splitting")
+                self._split_off = True
+                return rc
+            if r < rc:
+                rc = r
+        return rc
+
