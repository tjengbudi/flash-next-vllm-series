+class _PLEAdviseHelpers:
+    """local-34: persistent threads that run one process_madvise each.
+
+    submit(i, addr, count) hands helper ``i`` an iovec slice; its return code
+    arrives on ``done``. The threads block on their queue between calls and
+    hold the GIL only around the ctypes call, which releases it.
+    """
+
+    def __init__(self, libc, pidfd: int, sys_nr: int, advice: int):
+        self.done: "queue.SimpleQueue[int]" = queue.SimpleQueue()
+        self._queues: list[queue.SimpleQueue] = []
+        self._args = (libc, pidfd, sys_nr, advice)
+
+    def ensure(self, num: int) -> None:
+        """Start helpers until there are ``num``."""
+        while len(self._queues) < num:
+            q: queue.SimpleQueue = queue.SimpleQueue()
+            self._queues.append(q)
+            threading.Thread(
+                target=self._run, args=(q, *self._args),
+                name=f"ple-advise-{len(self._queues)}", daemon=True,
+            ).start()
+
+    def submit(self, i: int, addr: int, count: int) -> None:
+        self._queues[i].put((addr, count))
+
+    def _run(self, q, libc, pidfd: int, sys_nr: int, advice: int) -> None:
+        done = self.done
+        while True:
+            addr, count = q.get()
+            try:
+                rc = libc.syscall(sys_nr, pidfd, ctypes.c_void_p(addr), count, advice, 0)
+            except Exception:  # never leave advise_now waiting
+                rc = -1
+            done.put(rc)
+
+
