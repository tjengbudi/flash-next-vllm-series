+# local-03 (flash-next): per-step cache for the "align" state-index math.
+# A hybrid model with many KV-cache groups (Flash-Next: 21) builds GDN metadata
+# once per group per step, and every build recomputed the same start indices
+# from the same seq_lens (~5 tiny GPU ops each, ~3 ms/token of CPU on the
+# critical PP rank). build_attn_metadata opens a scope for one step; inside it
+# only the per-group gather runs. VLLM_MAMBA_IDX_STEP_CACHE=0 turns it off.
+_MAMBA_IDX_STEP_CACHE_ON = (
+    __import__("os").environ.get("VLLM_MAMBA_IDX_STEP_CACHE", "1").strip()
+    not in ("", "0")
+)
+_mamba_idx_step_cache: dict | None = None
+_mamba_offsets_cache: dict = {}
+
+
+class mamba_idx_step_scope:
+    """Cache mamba_get_block_table_tensor's indices for one metadata build."""
+
+    def __enter__(self):
+        global _mamba_idx_step_cache
+        if _MAMBA_IDX_STEP_CACHE_ON and not torch.cuda.is_current_stream_capturing():
+            _mamba_idx_step_cache = {}
+        return self
+
+    def __exit__(self, *exc):
+        global _mamba_idx_step_cache
+        _mamba_idx_step_cache = None
+        return False
+
+
 def mamba_get_block_table_tensor(
     block_table: torch.Tensor,
     seq_lens: torch.Tensor,
@@ -1181,6 +1210,22 @@ def mamba_get_block_table_tensor(
         return block_table
     else:
         assert isinstance(kv_cache_spec, MambaSpec)
+        cache = _mamba_idx_step_cache
+        if cache is not None:
+            n = 1 + kv_cache_spec.num_speculative_blocks
+            key = (id(seq_lens), kv_cache_spec.block_size, n, block_table.device)
+            hit = cache.get(key)
+            if hit is None:
+                okey = (block_table.device, n)
+                offsets = _mamba_offsets_cache.get(okey)
+                if offsets is None:
+                    offsets = torch.arange(n, device=block_table.device, dtype=torch.int32)
+                    _mamba_offsets_cache[okey] = offsets
+                start = (seq_lens - 1) // kv_cache_spec.block_size
+                start.clamp_(min=0)
+                # Keep seq_lens alive with the entry so its id stays unique.
+                hit = cache[key] = (seq_lens, (start.unsqueeze(1) + offsets).to(torch.int64))
+            return torch.gather(block_table, 1, hit[1])
         # NOTE: For 0-length requests in CUDA graph, use a start_index of 0
         # to handle the invalid block table.
         start_indices = (seq_lens - 1) // kv_cache_spec.block_size
