+_PLE_GATHER_ADVISE = os.environ.get("VLLM_PLE_GATHER_ADVISE", "1").strip() not in ("", "0")
 _PLE_PREFETCH_BATCH_ENV = "VLLM_PLE_PREFETCH_BATCH"  # tokens per advise batch
 
 
