diff --git a/vllm/v1/worker/gpu/model_runner.py b/vllm/v1/worker/gpu/model_runner.py
index c9d79a9..9ea954d 100644
--- a/vllm/v1/worker/gpu/model_runner.py
+++ b/vllm/v1/worker/gpu/model_runner.py
@@ -1232,8 +1232,39 @@ class GPUModelRunner(LoRAModelRunnerMixin):
                 self.kv_caches,
                 self.kv_cache_config.num_blocks,
                 scheduler_output.kv_cache_block_copies,
+                dst_block_layers=self._cow_dst_block_layers(scheduler_output),
             )
 
+    def _cow_dst_block_layers(
+        self, scheduler_output: SchedulerOutput
+    ) -> dict[int, frozenset[str]]:
+        """Layer names of the KV cache group each copy-on-write target belongs to.
+
+        One partial-block hit makes one copy per KV cache group (attention and
+        mamba alike). Hooks that copy storage outside kv_caches use this to
+        skip the copies of groups their layers are not in.
+        """
+        copies = scheduler_output.kv_cache_block_copies or ()
+        dsts = {copy.dst_block_id for copy in copies}
+        groups = self.kv_cache_config.kv_cache_groups
+        found: dict[int, frozenset[str]] = {}
+
+        def scan(block_ids) -> None:
+            if block_ids is None:
+                return
+            for group_id, ids in enumerate(block_ids):
+                for block_id in ids:
+                    if block_id in dsts and block_id not in found:
+                        found[block_id] = frozenset(groups[group_id].layer_names)
+
+        for new_req in scheduler_output.scheduled_new_reqs:
+            scan(new_req.block_ids)
+        for block_ids in scheduler_output.scheduled_cached_reqs.new_block_ids:
+            scan(block_ids)
+        for block_ids in (scheduler_output.block_table_updates or {}).values():
+            scan(block_ids)
+        return found
+
     def gather_batch_req_state(
         self, scheduler_output: SchedulerOutput, dummy_run: bool
     ) -> tuple["BatchReqState | None", int | None]:
