+@triton.jit
+def _ple_int8_dequant_kernel(
+    src_ptr,
+    out_ptr,
+    ROW_BYTES: tl.constexpr,
+    DIM: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    """One staged INT8 row (DIM int8, then an fp16 scale) -> DIM output values."""
+    row = tl.program_id(0).to(tl.int64)
+    base = src_ptr + row * ROW_BYTES
+    offs = tl.arange(0, BLOCK)
+    mask = offs < DIM
+    q = tl.load(base + offs, mask=mask, other=0)
+    lo = tl.load(base + DIM).to(tl.uint16)
+    hi = tl.load(base + DIM + 1).to(tl.uint16)
+    scale = ((hi << 8) | lo).to(tl.float16, bitcast=True).to(tl.float32)
+    values = q.to(tl.int8, bitcast=True).to(tl.float32) * scale
+    tl.store(out_ptr + row * DIM + offs, values.to(out_ptr.dtype.element_ty), mask=mask)
 
