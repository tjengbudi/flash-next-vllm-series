+    def _map_int8_table(
+        self, num_embeddings: int, embedding_dim: int, dtype: torch.dtype
+    ) -> torch.Tensor:
+        """local-49: map the INT8 table; return a zero-size stand-in weight."""
+        import json
+        import struct
+
+        path = self._int8_path
+        with open(path, "rb") as handle:
+            header_len = struct.unpack("<Q", handle.read(8))[0]
+            header = json.loads(handle.read(header_len))
+        shards = sorted(
+            (
+                (int(name.rsplit("_", 1)[1]), info)
+                for name, info in header.items()
+                if ".ngram_q8.shard_" in name
+            ),
+        )
+        row_bytes = embedding_dim + 2
+        if not shards:
+            raise RuntimeError(f"{path} holds no ngram_q8.shard_* tensors")
+        for (index, info), (_, nxt) in zip(shards, shards[1:]):
+            if info["data_offsets"][1] != nxt["data_offsets"][0]:
+                raise RuntimeError(f"{path}: shard {index} is not followed by shard {index + 1}")
+        for index, info in shards:
+            if info["dtype"] != "U8" or info["shape"][1] != row_bytes:
+                raise RuntimeError(
+                    f"{path}: shard {index} is {info['dtype']} {info['shape']}, "
+                    f"expected U8 [rows, {row_bytes}]"
+                )
+        start = shards[0][1]["data_offsets"][0]
+        rows = (shards[-1][1]["data_offsets"][1] - start) // row_bytes
+        if rows != num_embeddings:
+            raise RuntimeError(
+                f"{path} has {rows} rows but this model needs {num_embeddings}"
+            )
+        self._mmap_array = np.memmap(
+            path, dtype=np.uint8, mode="r", offset=8 + header_len + start,
+            shape=(rows, row_bytes),
+        )
+        self._mmap_prefilled = True
+        raw_map = getattr(self._mmap_array, "_mmap", None)
+        if raw_map is not None and hasattr(raw_map, "madvise"):
+            try:
+                raw_map.madvise(mmap.MADV_RANDOM)
+            except OSError as err:
+                logger.warning("MADV_RANDOM on the PLE table failed: %s", err)
+        logger.info(
+            "PLE table mapped from %s as INT8 rows (%.2f GiB, local-49)",
+            path, rows * row_bytes / (1 << 30),
+        )
+        if os.environ.get(_PLE_INT8_LOCK_ENV, "0").strip() not in ("", "0"):
+            self._start_int8_lock()
+        # The checkpoint copy is skipped (prefilled), so the weight only has to
+        # carry the shape and dtype; it owns one element.
+        return torch.zeros(1, dtype=dtype).as_strided(
+            (num_embeddings, embedding_dim), (0, 0)
+        )
+
+    def _start_int8_lock(self) -> None:
+        """local-49b: mlock the whole mapped table in a background thread."""
+        import time
+
+        array = self._mmap_array
+        addr, nbytes = array.ctypes.data, array.nbytes
+
+        path = self._int8_path
+        offset = int(array.offset)
+
+        def lock() -> None:
+            libc = ctypes.CDLL("libc.so.6", use_errno=True)
+            start = time.monotonic()
+            # The mapping is MADV_RANDOM (no readahead), so mlock alone faults
+            # the cold table in 4 KiB at a time (~1000 s on the rig). Read the
+            # file sequentially first (~2 min), then lock the cached pages.
+            try:
+                fd = os.open(path, os.O_RDONLY)
+                try:
+                    os.posix_fadvise(fd, offset, nbytes, os.POSIX_FADV_SEQUENTIAL)
+                    pos, end, chunk = offset, offset + nbytes, 64 << 20
+                    while pos < end:
+                        got = os.pread(fd, min(chunk, end - pos), pos)
+                        if not got:
+                            break
+                        pos += len(got)
+                finally:
+                    os.close(fd)
+            except OSError as err:
+                logger.warning("PLE INT8 table pre-read failed: %s", err)
+            rc = libc.mlock(ctypes.c_void_p(addr), ctypes.c_size_t(nbytes))
+            err = ctypes.get_errno()
+            if rc == 0:
+                logger.info(
+                    "PLE INT8 table locked in RAM (%.2f GiB, %.0f s)",
+                    nbytes / (1 << 30), time.monotonic() - start,
+                )
+            else:
+                logger.warning(
+                    "mlock of the PLE INT8 table failed (%s); it stays in the "
+                    "page cache only", os.strerror(err),
+                )
+
+        threading.Thread(target=lock, name="ple-int8-mlock", daemon=True).start()
