+    _block_topk_kernel[(R, nb)](x, keys, V, x.stride(0), nb, BLOCK=BLOCK, KB=KB, num_warps=8)
+    top = torch.topk(keys, KB, dim=-1).values                    # descending
+    idx = (top & 0xFFFFFFFF).to(torch.int64)
+    vals = x.gather(1, idx)
+    keep = torch.arange(KB, device=x.device)[None, :] < k[:, None].to(torch.int64)
+    vals = vals.masked_fill(~keep, float("-inf"))
+    if p is not None:
+        asc = vals.flip(-1)
+        cum = asc.softmax(-1).cumsum(-1)
+        m = cum <= (1 - p[:, None]); m[:, -1] = False
+        vals = asc.masked_fill(m, float("-inf")).flip(-1)
+    out = torch.full_like(x, float("-inf"))
+    return out.scatter_(1, idx, vals)
