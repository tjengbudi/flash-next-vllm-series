+    mono = tl.where(bits >= 0, bits, bits ^ 0x7FFFFFFF)
+    key = (mono.to(tl.int64) << 32) | tl.minimum(offs, V - 1).to(tl.int64)
+    top = tl.topk(key, KB)
+    out = key_ptr + (row * nblocks + blk) * KB + tl.arange(0, KB)
+    tl.store(out, top)
+
+
+def compact_top_k_top_p(x, k, p, KB=32, BLOCK=4096):
+    """Same mask as apply_top_k_top_p when every row has 1 <= top_k <= KB."""
+    R, V = x.shape
+    nb = triton.cdiv(V, BLOCK)
