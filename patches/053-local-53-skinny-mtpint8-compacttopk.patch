+# SPDX-License-Identifier: Apache-2.0
+"""local-53: small-batch GEMM and compact top-k sampling for decode on sm_86.
+
+skinny_linear: y = x @ w.T for x with at most 16 rows (decode / verify / MTP draft
+steps), w bf16 or int8 with a per-row scale. At these sizes the GEMM only streams
+the weight, and cuBLAS' kernels for them run below memory bandwidth on Ampere.
+
+compact_top_k_top_p: the top-k / top-p mask of apply_top_k_top_p when every row
+has 1 <= top_k <= 32, found through per-block top-32 candidates instead of a
+search over the whole vocabulary.
+"""
+import torch, triton, triton.language as tl
+
+@triton.jit
+def _skinny_kernel(x_ptr, w_ptr, s_ptr, out_ptr, M, N, K, stride_xm, stride_wn, stride_om,
+                   BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,
+                   SPLIT_K: tl.constexpr, IS_INT8: tl.constexpr):
+    pid_n = tl.program_id(0); pid_k = tl.program_id(1)
+    offs_m = tl.arange(0, BLOCK_M); offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+    k_per = tl.cdiv(K, SPLIT_K * BLOCK_K) * BLOCK_K
+    k_lo = pid_k * k_per
+    for k0 in range(k_lo, tl.minimum(k_lo + k_per, K), BLOCK_K):
+        offs_k = k0 + tl.arange(0, BLOCK_K)
+        x = tl.load(x_ptr + offs_m[:, None] * stride_xm + offs_k[None, :],
+                    mask=(offs_m[:, None] < M) & (offs_k[None, :] < K), other=0.0)
+        w = tl.load(w_ptr + offs_n[:, None] * stride_wn + offs_k[None, :],
+                    mask=(offs_n[:, None] < N) & (offs_k[None, :] < K), other=0)
+        if IS_INT8:
+            w = w.to(tl.bfloat16)
+        acc += tl.dot(x, tl.trans(w))
+    if IS_INT8:
+        s = tl.load(s_ptr + offs_n, mask=offs_n < N, other=0.0)
+        acc = acc * s[None, :]
+    optr = out_ptr + pid_k * M * N + offs_m[:, None] * stride_om + offs_n[None, :]
+    tl.store(optr, acc, mask=(offs_m[:, None] < M) & (offs_n[None, :] < N))
+
+_NUM_SMS: dict = {}
+
+
+def skinny_linear(x, w, scale=None, num_sms=None):
+    """y = x @ w.T (* scale) for x [M<=16, K] bf16, w [N, K] bf16 or int8 (per-row scale)."""
+    if num_sms is None:
+        num_sms = _NUM_SMS.get(x.device)
+        if num_sms is None:
+            num_sms = torch.cuda.get_device_properties(x.device).multi_processor_count
+            _NUM_SMS[x.device] = num_sms
+    M, K = x.shape; N = w.shape[0]
+    BLOCK_N, BLOCK_K = 32, 128
+    nb = triton.cdiv(N, BLOCK_N)
+    split = 1
+    while nb * split < 2 * num_sms and split < 8 and K // (split * 2) >= 4 * BLOCK_K:
+        split *= 2
+    part = torch.empty((split, M, N), dtype=torch.float32, device=x.device)
+    _skinny_kernel[(nb, split)](x, w, scale if scale is not None else x, part, M, N, K,
+        x.stride(0), w.stride(0), N, BLOCK_M=16, BLOCK_N=BLOCK_N, BLOCK_K=BLOCK_K,
+        SPLIT_K=split, IS_INT8=scale is not None, num_warps=4, num_stages=3)
+    return (part[0] if split == 1 else part.sum(0)).to(x.dtype)
+
+def quant_int8_rows(w):
+    s = w.float().abs().amax(1).clamp(min=1e-8) / 127.0
+    q = torch.round(w.float() / s[:, None]).clamp(-127, 127).to(torch.int8)
+    return q, s
+
+
+
+@triton.jit
+def _block_topk_kernel(x_ptr, key_ptr, V, stride_x, nblocks,
+                       BLOCK: tl.constexpr, KB: tl.constexpr):
+    """Per (row, BLOCK-logit block): the block's KB largest logits as sortable keys
+    (monotonic float bits << 32 | index)."""
+    row = tl.program_id(0); blk = tl.program_id(1)
+    offs = blk * BLOCK + tl.arange(0, BLOCK)
