+@triton.jit(do_not_specialize=["pages_per_bucket", "num_buckets"])
+def _qsa_bucket_partition_kernel(
+    indices_ptr,
+    row_map_ptr,
+    part_ptr,
+    part_start_ptr,
+    stride_indices_row,
+    stride_part_row,
+    stride_part_start_row,
+    pages_per_bucket,
+    num_buckets,
+    TOPK: tl.constexpr,
+    PAGE_SIZE: tl.constexpr,
+    BLOCK: tl.constexpr,
+) -> None:
+    """local-51: group one row's selected tokens by staging bucket.
+
+    Writes the row's valid tokens bucket by bucket (each bucket keeps the
+    original order) and the bucket start columns, so a bucket's kernel launch
+    walks only its own tokens instead of the whole selection.
+    """
+    local_row = tl.program_id(0)
+    row = tl.load(row_map_ptr + local_row)
+    columns = tl.arange(0, BLOCK)
+    valid_count = tl.load(indices_ptr + row * stride_indices_row + TOPK)
+    in_range = columns < tl.minimum(valid_count, TOPK)
+    token = tl.load(
+        indices_ptr + row * stride_indices_row + columns, mask=in_range, other=-1
+    )
+    valid = in_range & (token >= 0)
+    token_bucket = (tl.maximum(token, 0) // PAGE_SIZE) // pages_per_bucket
+    offset = 0
+    for b in range(0, num_buckets):
+        tl.store(part_start_ptr + local_row * stride_part_start_row + b, offset)
+        selected = valid & (token_bucket == b)
+        position = offset + tl.cumsum(selected.to(tl.int32), 0) - 1
+        tl.store(part_ptr + local_row * stride_part_row + position, token, mask=selected)
+        offset += tl.sum(selected.to(tl.int32), 0)
+    tl.store(part_start_ptr + local_row * stride_part_start_row + num_buckets, offset)
+
+
 def qsa_staged_arena_pages(arena_bytes: int, page_bytes: int) -> int:
     """Number of logical pages the staging arena holds (at least one)."""
     return max(1, arena_bytes // max(page_bytes, 1))
