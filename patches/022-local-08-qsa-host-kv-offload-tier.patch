+def _group_host_bytes(
+    vllm_config: "VllmConfig",
+    selected_groups: "tuple[tuple[int, KVCacheGroupSpec], ...]",
+) -> dict[int, int]:
+    """local-08: host-resident K/V bytes per block, per group, widest rank.
+
+    Qwen4Exp QSA with VLLM_QSA_KV_OFFLOAD=1 keeps the K/V of its attention
+    layers in host memory, and the worker offloads it with the block. Their
+    specs keep one head slot on the GPU (num_head_slots == 1); the indexer
+    layers sharing the group stay on the GPU. The figure counts the QSA
+    layers of the PP rank holding the most, taken from the model config, so
+    the scheduler and every worker (each of which sees only its own layers)
+    arrive at the same pool layout.
+    """
+    from vllm.distributed.utils import get_pp_indices
+    from vllm.platforms.interface import _qsa_offload_host_bytes_per_layer
+    from vllm.v1.kv_cache_interface import UniformTypeKVCacheSpecs
+
+    per_layer = _qsa_offload_host_bytes_per_layer(vllm_config)
+    if not per_layer:
+        return {}
+
+    def has_host_layers(group: "KVCacheGroupSpec") -> bool:
+        spec = group.kv_cache_spec
+        if isinstance(spec, UniformTypeKVCacheSpecs):
+            return any(
+                getattr(s, "num_head_slots", None) == 1
+                for s in spec.kv_cache_specs.values()
+            )
+        # Scheduler configs flatten UniformTypeKVCacheSpecs to one
+        # representative layer spec, which may be an indexer layer's, so the
+        # scheduler also goes by the QSA attention layer names.
+        return getattr(spec, "num_head_slots", None) == 1 or any(
+            name.endswith(".self_attn.attn") for name in group.layer_names
+        )
+
+    text_config = vllm_config.model_config.hf_text_config
+    layer_types = getattr(text_config, "layer_types", None) or []
+    full = [i for i, kind in enumerate(layer_types) if kind == "full_attention"]
+    pp_size = vllm_config.parallel_config.pipeline_parallel_size
+    counts = []
+    for rank in range(pp_size):
+        start, end = get_pp_indices(len(layer_types), rank, pp_size)
+        counts.append(sum(start <= i < end for i in full))
+    if vllm_config.speculative_config is not None:
+        # The drafter's attention layers are built on the last rank.
+        counts[-1] += max(1, int(getattr(text_config, "mtp_num_hidden_layers", 1) or 1))
+    widest = max(counts)
+    return {
+        group_id: widest * per_layer
+        for group_id, group in selected_groups
+        if has_host_layers(group)
+    }
