+def _qsa_offload_host_bytes_per_layer(vllm_config: "VllmConfig") -> int:
+    """Host K/V bytes per KV block of one QSA layer under QSA offload, else 0.
+
+    KV offloading reserves this per host-resident layer in its CPU chunks
+    (local-08).
+    """
+    if os.environ.get("VLLM_QSA_KV_OFFLOAD", "0") != "1":
+        return 0
+    text_config = vllm_config.model_config.hf_text_config
+    num_kv_heads = int(getattr(text_config, "num_key_value_heads", 1) or 1)
+    head_dim = int(
+        getattr(text_config, "head_dim", 0)
+        or text_config.hidden_size // text_config.num_attention_heads
+    )
+    fp8 = str(vllm_config.cache_config.cache_dtype).startswith("fp8")
+    itemsize = 1 if fp8 else vllm_config.model_config.dtype.itemsize
+    block_size = vllm_config.cache_config.block_size
+    return num_kv_heads * block_size * 2 * head_dim * itemsize
