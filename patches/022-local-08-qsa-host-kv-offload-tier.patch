+    def _add_host_resident_kv(self, kv_caches: CanonicalKVCaches) -> None:
+        """local-08: offload host-resident K/V with its block.
+
+        Layers that keep K/V in host memory (Qwen4Exp QSA with
+        VLLM_QSA_KV_OFFLOAD=1) hold only a slot in kv_caches. Their host view
+        becomes one more tensor of the group, so every store and load copies
+        it in the same batch as the GPU part, on the same stream. The CPU side
+        keeps it in the rows of the group's chunk pool (CPUOffloadingSpec).
+        """
+        from vllm.v1.worker.utils import KV_CACHE_HOST_RESIDENT_VIEWS
+
+        if not KV_CACHE_HOST_RESIDENT_VIEWS:
+            return
+        kv_cache_config = self.kv_cache_config
+        num_blocks = kv_cache_config.num_blocks
+        budgets = self.spec.config.group_host_bytes
+        selected_group_ids = get_offloading_group_ids(kv_cache_config)
+        assert len(selected_group_ids) == len(kv_caches.group_data_refs)
+        added_layers = 0
+        for refs, group_id in zip(kv_caches.group_data_refs, selected_group_ids):
+            group_bytes = 0
+            for layer_name in kv_cache_config.kv_cache_groups[group_id].layer_names:
+                view = KV_CACHE_HOST_RESIDENT_VIEWS.get(layer_name)
+                if view is None:
+                    continue
+                # Kernel blocks of one manager block are adjacent rows.
+                tensor = view.view(torch.int8).reshape(num_blocks, -1)
+                page = tensor.shape[1]
+                canonical = CanonicalKVCacheTensor(tensor, page)
+                canonical.host_group_id = group_id
+                kv_caches.tensors.append(canonical)
+                refs.append(CanonicalKVCacheRef(len(kv_caches.tensors) - 1, page))
+                group_bytes += page
+                added_layers += 1
+            if group_bytes > budgets.get(group_id, 0):
+                raise RuntimeError(
+                    f"KV offload: group {group_id} has {group_bytes} bytes of "
+                    "host-resident K/V per block on this rank, but its chunk "
+                    f"pool was sized for {budgets.get(group_id, 0)}."
+                )
+        if added_layers:
+            logger.info(
+                "KV offload: %d host-resident K/V layers join their blocks "
+                "(group budgets: %s)",
+                added_layers,
+                {g: f"{b / 2**20:.1f} MiB" for g, b in budgets.items()},
+            )
