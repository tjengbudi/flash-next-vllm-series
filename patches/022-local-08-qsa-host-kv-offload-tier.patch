+        for pool, pool_keys in self._split(keys).items():
+            output = self._pools[pool].prepare_store(
+                pool_keys, self._ctx(req_context, pool)
+            )
+            if output is None:
+                # All or nothing: release what the other pools reserved.
+                for done_pool, done in outputs.items():
+                    self._pools[done_pool].complete_store(
+                        done.keys_to_store,
+                        self._ctx(req_context, done_pool),
+                        success=False,
+                    )
+                return None
+            outputs[pool] = output
+        to_store = {key for out in outputs.values() for key in out.keys_to_store}
+        keys_to_store = [key for key in keys if key in to_store]
+        store_spec = self._merge_ids(
+            keys_to_store,
+            {
+                pool: (out.keys_to_store, out.store_spec)
+                for pool, out in outputs.items()
+            },
+        )
+        return PrepareStoreOutput(
+            keys_to_store=keys_to_store,
+            store_spec=store_spec,
+            evicted_keys=[key for out in outputs.values() for key in out.evicted_keys],
+        )
+
+    @override
+    def complete_store(
+        self,
+        keys: Collection[OffloadKey],
+        req_context: ReqContext,
+        success: bool = True,
+    ) -> None:
+        for pool, pool_keys in self._split(keys).items():
+            self._pools[pool].complete_store(
+                pool_keys, self._ctx(req_context, pool), success=success
+            )
+
+    @override
+    def on_request_finished(self, req_context: ReqContext) -> None:
+        for pool, manager in enumerate(self._pools):
+            manager.on_request_finished(self._ctx(req_context, pool))
+
+    @override
+    def on_schedule_end(self, context) -> None:
+        for manager in self._pools:
+            manager.on_schedule_end(context)
+
+    @override
+    def has_pending_work(self) -> bool:
+        return any(manager.has_pending_work() for manager in self._pools)
+
+    @override
+    def reset_cache(self) -> None:
+        for manager in self._pools:
+            manager.reset_cache()
+
+    @override
+    def take_events(self) -> Iterable[OffloadingEvent]:
+        for manager in self._pools:
+            yield from manager.take_events()
+
+    def get_stats(self) -> OffloadingConnectorStats | None:
+        # Every pool clears its per-step counters; report the first pool
+        # (the largest host rows), which fills up first.
+        stats = [manager.get_stats() for manager in self._pools]
+        return stats[0]
+
+    @override
+    def shutdown(self) -> None:
+        for manager in self._pools:
+            manager.shutdown()
