+class PooledCPUOffloadingManager(OffloadingManager):
+    """local-08: CPU offloading over several chunk pools, routed by group.
+
+    Pool p owns chunk ids [offsets[p], offsets[p] + its size). Groups whose
+    chunks carry host-resident K/V use a pool whose rows have room for it;
+    the other groups use a pool whose rows hold only the GPU part. Each pool
+    is a CPUOffloadingManager with its own eviction.
+    """
+
+    def __init__(
+        self,
+        pools: list[CPUOffloadingManager],
+        group_pool: dict[int, int],
+        pool_offsets: list[int],
+    ):
+        self.medium: Medium = Medium.CPU
+        self._pools = pools
+        self._group_pool = group_pool
+        self._pool_offsets = pool_offsets
+
+    def _pool_of(self, key: OffloadKey) -> int:
+        return self._group_pool.get(get_offload_group_idx(key), 0)
+
+    def _split(self, keys: Iterable[OffloadKey]) -> dict[int, list[OffloadKey]]:
+        split: dict[int, list[OffloadKey]] = {}
+        for key in keys:
+            split.setdefault(self._pool_of(key), []).append(key)
+        return split
+
+    def _ctx(self, req_context: ReqContext, pool: int):
+        return _PoolReqContext(req_context, pool)
+
+    def _merge_ids(
+        self,
+        keys: list[OffloadKey],
+        per_pool: dict[int, tuple[list[OffloadKey], LoadStoreSpec]],
+    ) -> CPULoadStoreSpec:
+        ids: dict[OffloadKey, int] = {}
+        for pool, (pool_keys, spec) in per_pool.items():
+            assert isinstance(spec, CPULoadStoreSpec)
+            offset = self._pool_offsets[pool]
+            for key, chunk_id in zip(pool_keys, spec.block_ids):
+                ids[key] = int(chunk_id) + offset
+        return CPULoadStoreSpec([ids[key] for key in keys])
+
+    @override
+    def on_new_request(self, req_context: ReqContext) -> RequestOffloadingContext:
+        for pool, manager in enumerate(self._pools):
+            manager.on_new_request(self._ctx(req_context, pool))
+        return RequestOffloadingContext()
+
+    @override
+    def lookup(self, key: OffloadKey, req_context: ReqContext) -> LookupResult:
+        pool = self._pool_of(key)
+        return self._pools[pool].lookup(key, self._ctx(req_context, pool))
+
+    @override
+    def prepare_load(
+        self,
+        keys: Collection[OffloadKey],
+        req_context: ReqContext,
+    ) -> LoadStoreSpec:
+        keys = list(keys)
+        per_pool = {
+            pool: (
+                pool_keys,
+                self._pools[pool].prepare_load(pool_keys, self._ctx(req_context, pool)),
+            )
+            for pool, pool_keys in self._split(keys).items()
+        }
+        return self._merge_ids(keys, per_pool)
+
+    @override
+    def touch(self, keys: Collection[OffloadKey], req_context: ReqContext) -> None:
+        for pool, pool_keys in self._split(keys).items():
+            self._pools[pool].touch(pool_keys, self._ctx(req_context, pool))
+
+    @override
+    def complete_load(
+        self, keys: Collection[OffloadKey], req_context: ReqContext
+    ) -> None:
+        for pool, pool_keys in self._split(keys).items():
+            self._pools[pool].complete_load(pool_keys, self._ctx(req_context, pool))
+
+    @override
+    def prepare_store(
+        self,
+        keys: Collection[OffloadKey],
+        req_context: ReqContext,
+    ) -> PrepareStoreOutput | None:
+        keys = list(keys)
