+class _PoolReqContext:
+    """A ReqContext whose typed state is private to one pool.
+
+    CPUOffloadingManager keeps its per-request state in the context, keyed by
+    type, so pools sharing one context would overwrite each other's state.
+    """
+
+    def __init__(self, ctx: ReqContext, pool: int) -> None:
+        self._ctx = ctx
+        self._pool = pool
+
+    def _states(self) -> dict[type, object]:
+        holder = self._ctx.get_state(_PoolStates)
+        if holder is None:
+            holder = _PoolStates()
+            self._ctx.set_state(holder)
+        return holder.by_pool.setdefault(self._pool, {})
+
+    def get_state(self, cls):
+        return self._states().get(cls)
+
+    def set_state(self, val) -> None:
+        self._states()[type(val)] = val
+
+    def __getattr__(self, name):
