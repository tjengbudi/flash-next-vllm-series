+        if not use_lookup:
+            return draft_tokens
+        torch.where(has_match[:, None], ngram_drafts, draft_tokens, out=draft_tokens)
+        if self.draft_logits is not None:
+            write_one_hot_draft_logits(
+                self.draft_logits, input_batch.idx_mapping, has_match, ngram_drafts
+            )
+        return draft_tokens
diff -ruN a/vllm/v1/worker/gpu/spec_decode/ngram/speculator.py b/vllm/v1/worker/gpu/spec_decode/ngram/speculator.py
