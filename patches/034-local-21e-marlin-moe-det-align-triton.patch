+# local-21e: one-launch replacement for _deterministic_expert_order_torch.
+# One program per block_size slot of sorted_token_ids. A program whose block
+# holds valid entries (position < num_tokens_post_padded) finds its run (the
+# maximal stretch of consecutive blocks with the same expert_ids value, cut at
+# num_tokens_post_padded) and writes each of its entries to
+#   run_start + #{run entries with a smaller id, or an equal id earlier},
+# i.e. the stable sort of the run by token id. Positions at or past
+# num_tokens_post_padded (and the tail past n_blocks * block_size) are copied
+# unchanged, exactly like the torch version. Valid entries of a
+# moe_align_block_size output are in [0, topk_ids.numel()], so sorting by id
+# inside each run is the same order as the torch run*big+id key.
+@triton.jit(
+    do_not_specialize=["in_ptr", "out_ptr", "eid_ptr", "ntpp_ptr", "n", "n_blocks"]
+)
+def _det_expert_order_kernel(
+    in_ptr,
+    out_ptr,
+    eid_ptr,
+    ntpp_ptr,
+    n,
+    n_blocks,
+    BS: tl.constexpr,
+    BS_P2: tl.constexpr,
+    W: tl.constexpr,
+    CH: tl.constexpr,
+):
+    b = tl.program_id(0)
+    lane = tl.arange(0, BS_P2)
+    p = b * BS + lane
+    in_blk = (lane < BS) & (p < n)
+    vals = tl.load(in_ptr + p, mask=in_blk, other=0)
+
+    ntpp = tl.load(ntpp_ptr).to(tl.int32)
+    ntpp = tl.minimum(tl.maximum(ntpp, 0), n_blocks * BS)
+    valid_blk = b * BS < ntpp
+    nvb = (ntpp + BS - 1) // BS
+    eb = tl.load(eid_ptr + b, mask=valid_blk, other=0)
+    j = tl.arange(0, W)
+
+    # run start: walk back over blocks with the same expert id
+    s = b
+    go = valid_blk & (s > 0)
+    while go:
+        idx = s - 1 - j
+        ev = tl.load(eid_ptr + idx, mask=idx >= 0, other=0)
+        brk = (idx < 0) | (ev != eb)
+        first = tl.min(tl.where(brk, j, W), axis=0)
+        s = s - first
+        go = (first == W) & (s > 0)
+    # run end (exclusive), limited to blocks holding valid entries
+    t = b + 1
+    go = valid_blk & (t < nvb)
+    while go:
+        idx = t + j
+        ev = tl.load(eid_ptr + idx, mask=idx < nvb, other=0)
+        brk = (idx >= nvb) | (ev != eb)
+        first = tl.min(tl.where(brk, j, W), axis=0)
+        t = t + first
+        go = (first == W) & (t < nvb)
+
+    seg_lo = s * BS
+    seg_hi = tl.where(valid_blk, tl.minimum(t * BS, ntpp), seg_lo)
+    ranked = in_blk & (p < ntpp)
+    rank = tl.zeros([BS_P2], dtype=tl.int32)
+    q0 = tl.arange(0, CH)
+    for start in range(seg_lo, seg_hi, CH):
+        q = start + q0
+        mq = q < seg_hi
+        w = tl.load(in_ptr + q, mask=mq, other=0)
+        before = (w[None, :] < vals[:, None]) | (
+            (w[None, :] == vals[:, None]) & (q[None, :] < p[:, None])
+        )
+        rank += tl.sum((before & mq[None, :]).to(tl.int32), axis=1)
+    dst = tl.where(ranked, seg_lo + rank, p)
+    tl.store(out_ptr + dst, vals, mask=in_blk)
+
+
+# local-21e: after the first (JIT-dispatched) launch per (block_size, dtypes,
+# device) the compiled kernel is launched directly, skipping Triton's per-call
+# argument binding / specialization / cache-key work (~half the host cost on
+# the rig's slow vCPUs). No argument is specialized (see do_not_specialize), so
+# the cached binary is valid for every call with the same key. Any failure
+# falls back to the normal JIT launch. VLLM_MARLIN_MOE_DET_FAST_LAUNCH=0
+# always uses the JIT launch.
