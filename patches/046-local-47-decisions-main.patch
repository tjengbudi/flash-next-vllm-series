-
-    async def _render(
-        self, read_request: ReadPromptRequest, messages: list[dict[str, Any]]
-    ) -> tuple[EngineInput, list[int]]:
-        ctx = self.context
-        _, (engine_input,) = await ctx.online_renderer.preprocess_chat(
