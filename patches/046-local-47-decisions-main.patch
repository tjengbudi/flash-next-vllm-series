-        image_parts = await self._image_parts((media or {}).get("image", ()))
-
-        slots, engine_inputs, params, prompts = [], [], [], []
-        for q in questions:
-            content: Any = self._content(state, q)
-            if image_parts:
-                content = [*image_parts, {"type": "text", "text": content}]
-            messages = [{"role": "user", "content": content}]
