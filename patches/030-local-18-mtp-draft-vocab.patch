+    def _draft_vocab_rows(self, weight: torch.Tensor) -> torch.Tensor:
+        ids = self._draft_vocab_load_ids
+        assert ids is not None
+        if weight.dim() >= 1 and weight.shape[0] == self.config.vocab_size:
+            weight = weight.index_select(0, ids.to(weight.device))
+        return weight.detach().to("cpu").clone()
+
+    @property
+    def draft_vocab_active(self) -> bool:
+        return self._draft_vocab_head is not None
+
+    def _maybe_build_draft_vocab_head(self) -> None:
+        """local-18: build the sub-head last, after every layer's repack."""
+        path, tensors = self._draft_vocab_path, self._draft_vocab_tensors
+        ids = self._draft_vocab_load_ids
+        self._draft_vocab_path, self._draft_vocab_tensors = None, {}
+        self._draft_vocab_load_ids = None
+        if path is None or ids is None:
+            return
+        if not tensors:
+            logger.warning(
+                "local-18: the draft load saw no lm_head tensors; draft "
+                "vocabulary off"
+            )
+            return
+        try:
+            head = build_draft_vocab_head(
+                ids,
+                tensors,
+                self.config.vocab_size,
+                self.config.hidden_size,
+                self.quant_config,
+                self.model._device,
+                params_dtype=self.vllm_config.model_config.dtype,
+            )
+        except Exception as e:  # keep serving with the full head
+            logger.warning("local-18: draft vocabulary off: %s", e)
+            return
+        del tensors
+        self._draft_vocab_head = head
+        self._draft_vocab_ids = ids.to(self.model._device)
+        self._draft_vocab_num = ids.numel()
+        nbytes = sum(p.numel() * p.element_size() for p in head.parameters())
+        kernel = getattr(getattr(head, "scheme", None), "kernel", head.quant_method)
+        logger.info(
+            "local-18: MTP greedy drafts use a %d-of-%d id draft vocabulary "
+            "(%s, %s, %.1f MiB)",
+            ids.numel(),
+            self.config.vocab_size,
+            path,
+            type(kernel).__name__,
+            nbytes / 2**20,
+        )
+
+    def get_top_tokens(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        """Greedy draft ids. With the draft vocabulary, the argmax over its
+        rows only (sorted ids, so ties keep the lowest id like the full head);
+        without it, the full head's argmax."""
+        head = self._draft_vocab_head
+        if head is None:
+            return self.logits_processor.get_top_tokens(self.lm_head, hidden_states)
+        logits = head.quant_method.apply(head, hidden_states, bias=None)
+        logits = logits[..., : self._draft_vocab_num]
+        assert self._draft_vocab_ids is not None
+        return self._draft_vocab_ids[logits.argmax(dim=-1)]
 
