+logger = init_logger(__name__)
+
+# local-18: draft-only vocabulary for the MTP drafter.
+#
+# Greedy drafting only needs the argmax of the draft logits, yet the shared
+# lm_head scores all 248,320 ids (an INT8 read of ~636 MB per draft step). With
+# VLLM_MTP_DRAFT_VOCAB set, greedy drafts are scored by a second, small head
+# that holds only a fixed subset of rows: the checkpoint's own INT8 rows and
+# group scales, built with the same quant method (Marlin W8A16 on sm_86) as
+# the target head. The target still verifies with the full head, so outputs
+# are unchanged; a token outside the subset is never drafted, which can only
+# lower acceptance. Probabilistic drafting and adaptive verification need the
+# full draft logits and keep the full head.
+#
+#   VLLM_MTP_DRAFT_VOCAB=0 or unset  off (no extra memory, l15 behaviour)
+#   VLLM_MTP_DRAFT_VOCAB=1           the id list baked next to this file
+#   VLLM_MTP_DRAFT_VOCAB=/path.json  a JSON list of token ids (or a .pt tensor)
+DRAFT_VOCAB_BAKED_IDS = os.path.join(
+    os.path.dirname(os.path.abspath(__file__)), "mtp_draft_vocab_ids.json"
+)
+
+
+def draft_vocab_ids_path() -> str | None:
+    value = os.environ.get("VLLM_MTP_DRAFT_VOCAB", "0").strip()
+    if value in ("", "0"):
+        return None
+    return DRAFT_VOCAB_BAKED_IDS if value == "1" else value
+
+
+def load_draft_vocab_ids(path: str, vocab_size: int) -> torch.Tensor:
+    """Sorted, unique int64 ids; sorted keeps argmax's lowest-id tie break."""
+    if path.endswith(".pt"):
+        ids = torch.as_tensor(torch.load(path, map_location="cpu"))
+    else:
+        with open(path, encoding="utf-8") as f:
+            ids = torch.tensor(json.load(f), dtype=torch.int64)
+    ids = torch.unique(ids.to(torch.int64).flatten())
+    if ids.numel() == 0 or int(ids[0]) < 0 or int(ids[-1]) >= vocab_size:
+        raise ValueError(
+            f"draft vocabulary {path}: ids must be non-empty and in [0, {vocab_size})"
+        )
+    return ids
+
+
+def build_draft_vocab_head(
+    ids: torch.Tensor,
+    head_tensors: dict[str, torch.Tensor],
+    vocab_size: int,
+    hidden_size: int,
+    quant_config,
+    device: torch.device,
+    params_dtype: torch.dtype | None = None,
+    prefix: str = "lm_head",
+) -> ParallelLMHead:
+    """A ParallelLMHead over `ids`, from the full head's checkpoint tensors.
+
+    `head_tensors` maps the head's parameter names (weight, or weight_packed /
+    weight_scale / weight_shape for compressed-tensors) to the full-vocab
+    tensors (or to tensors already cut down to `ids`). Rows are selected on
+    the output (vocab) dim, so each kept row is bit-identical to the target
+    head's row before the kernel repack.
+    """
+    num_ids = ids.numel()
+    with torch.device(device):
+        head = ParallelLMHead(
+            num_ids,
+            hidden_size,
+            params_dtype=params_dtype,
+            quant_config=quant_config,
+            prefix=prefix,
+        )
+    ids_cpu = ids.cpu()
+    for name, param in head.named_parameters():
+        if name not in head_tensors:
+            raise ValueError(f"checkpoint has no lm_head.{name}")
+        src = head_tensors[name]
+        output_dim = getattr(param, "output_dim", None)
+        if name == "weight_shape":
+            loaded = torch.tensor([num_ids, hidden_size], dtype=src.dtype)
+        elif output_dim is None:
+            loaded = src
+        else:
+            if getattr(param, "packed_dim", None) == output_dim:
+                raise ValueError(f"lm_head.{name} is packed on the vocab dim")
+            if src.shape[output_dim] == vocab_size:
+                loaded = src.index_select(output_dim, ids_cpu.to(src.device))
+            elif src.shape[output_dim] == num_ids:
+                loaded = src
+            else:
+                raise ValueError(
+                    f"lm_head.{name} has {src.shape[output_dim]} rows, "
+                    f"expected {vocab_size}"
+                )
+        # Host -> device straight into the parameter: no second device copy.
+        param.weight_loader(param, loaded)
+    quant_method = head.quant_method
+    if hasattr(quant_method, "process_weights_after_loading"):
+        quant_method.process_weights_after_loading(head)
+    return head
+
 
