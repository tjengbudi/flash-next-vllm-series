+# local-06 (flash-next): experts per repack chunk. The temporaries of one chunk
+# are 1/(num_experts/chunk) of a layer's expert weights.
+_MARLIN_REPACK_CHUNK = 64
+
+
+def _marlin_repack_chunked(
+    qweight_nfirst: torch.Tensor,
+    prepare,
+    num_bits: int,
+    pack_factor: int,
+    is_a_8bit: bool,
+) -> torch.Tensor:
+    """N-first ``[E, N, K_packed]`` -> Marlin layout, a chunk of experts at a time.
+
+    The one-shot path transposes w13 and w2 to K-first copies, keeps both alive
+    and then repacks, so on top of the loaded weights a layer briefly holds two
+    full copies plus the repacked output. On a card filled to the brim by the
+    weights (3 x 24 GiB running Qwen3.8-Flash-Next) that is an OOM at load time.
+    Repacking per chunk into a preallocated output keeps the extra memory at the
+    output plus one chunk. Marlin repacks every expert on its own, so the result
+    is the same.
+
+    When an expert's repacked bytes equal its loaded bytes (no padding, no FP8
+    preprocessing), each chunk is written back over the loaded weights it was
+    read from: the chunk is copied out before it is overwritten, and expert e
+    occupies the same byte range in both layouts. The result is then a view of
+    the loaded storage and the extra memory is two chunks, below 0.30's peak.
+    """
+    num_experts = qweight_nfirst.shape[0]
+    source = qweight_nfirst.data
+    out = None
+    for start in range(0, num_experts, _MARLIN_REPACK_CHUNK):
+        end = min(start + _MARLIN_REPACK_CHUNK, num_experts)
+        chunk = prepare(source[start:end].transpose(1, 2).contiguous())
+        packed = ops.gptq_marlin_moe_repack(
+            chunk,
+            chunk.shape[1] * pack_factor,
+            chunk.shape[2],
+            num_bits,
+            is_a_8bit=is_a_8bit,
+        )
+        del chunk
+        if out is None:
+            in_place = (
+                source.is_contiguous()
+                and packed.dtype == source.dtype
+                and packed[0].numel() == source[0].numel()
+            )
+            if in_place:
+                out = source.view(-1).view(num_experts, *packed.shape[1:])
+            else:
+                out = packed.new_empty((num_experts, *packed.shape[1:]))
+        out[start:end].copy_(packed)
+        del packed
+    return out
+
+
