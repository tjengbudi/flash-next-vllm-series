+        """local-44: slot buffers for every commit tensor of the recorded step (one
+        buffer per distinct tensor), a graph that copies the recorded tensors into
+        them, and a graph of the deferred commit that reads them."""
+        assert self._rssm_ns is not None and self._rssm_idx is not None
+        bufs: dict[tuple[Any, ...], torch.Tensor] = {}
+        pairs: list[tuple[torch.Tensor, torch.Tensor]] = []
+        slot_step = []
+        for metadata in step:
+            commit = getattr(metadata, "recoverssm_commit", None)
+            if commit is None:
+                slot_step.append(metadata)
+                continue
+            repl = {}
+            for f in fields(commit):
+                v = getattr(commit, f.name)
+                if not isinstance(v, torch.Tensor):
+                    continue
+                k = (v.data_ptr(), v.dtype, tuple(v.shape), v.stride())
+                if k not in bufs:
+                    bufs[k] = torch.empty_like(v)
+                    pairs.append((bufs[k], v))
+                repl[f.name] = bufs[k]
+            slot_step.append(
+                replace(metadata, recoverssm_commit=replace(commit, **repl))
+            )
