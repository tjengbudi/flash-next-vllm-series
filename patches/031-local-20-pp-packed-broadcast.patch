+        # local-20: packed single-collective mode. Flat int64 wire buffer per
+        # step, n = num_reqs, msl = max_sample_len, ns = num_speculative_steps:
+        #   [ sampled n*msl | counts n (= 2n int32: num_sampled[n],
+        #     num_rejected[n]) | draft n*ns ]
+        # Every field is a contiguous zero-copy view of the buffer on both
+        # sides, with the same shapes/dtypes as the unpacked path. Size is a
+        # pure function of n, so send/recv element counts always match.
+        self.packed_bcast = _PP_PACKED_BCAST
+        self.packed_cols = self.max_sample_len + 1 + self.num_speculative_steps
+        # Last rank, spec decode: (buffer, draft view) staged by broadcast()
+        # and sent by broadcast_drafts() after the draft columns are filled.
+        self._staged_packed: tuple[torch.Tensor, torch.Tensor] | None = None
+        if self.packed_bcast:
+            logger.info(
+                "PP packed broadcast enabled (VLLM_PP_PACKED_BCAST=1): "
+                "1 collective per step, %d int64 per request",
+                self.packed_cols,
+            )
+
+    def _packed_views(
+        self, buf: torch.Tensor, n: int
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor | None]:
+        """(sampled [n, msl] i64, counts [2, n] i32, draft [n, ns] i64 | None)
+        as contiguous views of a freshly allocated (offset 0) flat buffer."""
+        msl = self.max_sample_len
+        ns = self.num_speculative_steps
+        sampled = buf.as_strided((n, msl), (msl, 1), 0)
+        counts = buf.view(torch.int32).as_strided((2, n), (n, 1), 2 * n * msl)
+        draft = buf.as_strided((n, ns), (ns, 1), n * (msl + 1)) if ns > 0 else None
+        return sampled, counts, draft
+
+    def _send_packed(self, buf: torch.Tensor) -> None:
+        with torch.cuda.stream(self.broadcast_stream):
+            self.broadcast_stream.wait_stream(self.main_stream)
+            torch.distributed.broadcast(
+                buf, src=self.last_rank, group=self.broadcast_group
+            )
+            # Allocated on the main stream, consumed on the broadcast stream.
+            buf.record_stream(self.broadcast_stream)
